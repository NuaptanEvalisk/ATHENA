[Unit]
Description=Cloudflare Tunnel for ATHENA Delegation
After=network-online.target athena-transmitter.service
Wants=network-online.target athena-transmitter.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/athena-delegation.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
