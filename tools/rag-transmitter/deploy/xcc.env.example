# Install as /etc/athena-rag-transmitter/xcc.env with mode 0640.
XCC_URL=https://172.16.99.2
XCC_SYSTEM_URI=/redfish/v1/Systems/1
XCC_NETRC=${CREDENTIALS_DIRECTORY:-/etc/athena-rag-transmitter}/xcc.netrc
ATHENA_RAG_BACKEND_IDENTITY_URL=http://100.103.71.75:8765/athena-rag/v1/identity
XCC_WAKE_TIMEOUT_SECONDS=900
XCC_WAKE_POLL_SECONDS=5
XCC_SHUTDOWN_TIMEOUT_SECONDS=300
XCC_SHUTDOWN_POLL_SECONDS=5
XCC_RUNTIME_DIR=/run/athena-rag-transmitter

# Provision xcc.netrc through the systemd encrypted credential configured by
# athena-rag-transmitter.service. Do not put credentials in this file.
