[Unit]
Description=Cloudflare Tunnel for ATHENA RAG Delegation
After=network-online.target athena-rag-transmitter.service
Wants=network-online.target athena-rag-transmitter.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/athena-rag.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
