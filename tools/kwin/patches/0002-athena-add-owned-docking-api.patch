+QString DBusInterface::athenaBeginDockDrag(const QString &uuid, const QString &callbackPath, int hotspotX, int hotspotY)
+{
+    const int callerPid = athenaCallerPid();
+    Window *window = athenaCallerWindow(uuid, callerPid);
+    if (!window || callbackPath.isEmpty() || window->isInteractiveMove() || window->isInteractiveResize()) {
+        return QString();
+    }
+
+    const QString dragId = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    AthenaDockDragSession session;
+    session.dragId = dragId;
+    session.service = message().service();
+    session.callbackPath = callbackPath;
+    session.callerPid = callerPid;
+    session.draggedWindow = window;
+    session.hotspot = QPointF(hotspotX, hotspotY);
+    m_athenaDockDragSessions.insert(dragId, session);
+
+    connect(window, &Window::interactiveMoveResizeStepped, this, [this, dragId](const RectF &) {
+        auto it = m_athenaDockDragSessions.find(dragId);
+        if (it == m_athenaDockDragSessions.end()) {
+            return;
+        }
+        it->latestState = athenaDockDragState(*it);
+        athenaSendDockDragCallback(*it, QStringLiteral("dockDragMoved"), it->latestState);
+    });
+    connect(window, &Window::interactiveMoveResizeFinished, this, [this, dragId]() {
+        athenaFinishDockDrag(dragId, false);
+    });
+    connect(window, &QObject::destroyed, this, [this, dragId]() {
+        athenaFinishDockDrag(dragId, true);
+    });
+
+    const QPointF pointer = input()->globalPointer();
+    window->performMousePressCommand(Options::MouseUnrestrictedMove, pointer);
+    if (!window->isInteractiveMove()) {
+        m_athenaDockDragSessions.remove(dragId);
+        return QString();
+    }
+
+    auto it = m_athenaDockDragSessions.find(dragId);
+    if (it != m_athenaDockDragSessions.end()) {
+        it->latestState = athenaDockDragState(*it);
+        athenaSendDockDragCallback(*it, QStringLiteral("dockDragMoved"), it->latestState);
+    }
+    return dragId;
+}
+
+bool DBusInterface::athenaCancelDockDrag(const QString &dragId)
+{
+    auto it = m_athenaDockDragSessions.find(dragId);
+    if (it == m_athenaDockDragSessions.end() || it->callerPid != athenaCallerPid()) {
+        return false;
+    }
+    if (it->draggedWindow && (it->draggedWindow->isInteractiveMove() || it->draggedWindow->isInteractiveResize())) {
+        it->draggedWindow->cancelInteractiveMoveResize();
+    } else {
+        athenaFinishDockDrag(dragId, true);
+    }
+    return true;
+}
+
+QVariantMap DBusInterface::athenaCurrentDockDragState(const QString &dragId)
+{
+    auto it = m_athenaDockDragSessions.find(dragId);
+    if (it == m_athenaDockDragSessions.end() || it->callerPid != athenaCallerPid()) {
+        return {};
+    }
+    it->latestState = athenaDockDragState(*it);
+    return it->latestState;
+}
+
+void DBusInterface::athenaFinishDockDrag(const QString &dragId, bool cancelled)
+{
+    auto it = m_athenaDockDragSessions.find(dragId);
+    if (it == m_athenaDockDragSessions.end()) {
+        return;
+    }
+
+    AthenaDockDragSession session = *it;
+    m_athenaDockDragSessions.erase(it);
+
+    QVariantMap state = session.latestState;
+    if (session.draggedWindow) {
+        state = athenaDockDragState(session);
+    }
+    state.insert(QStringLiteral("cancelled"), cancelled);
+
+    athenaSendDockDragCallback(
+        session,
+        cancelled ? QStringLiteral("dockDragCancelled") : QStringLiteral("dockDragDropped"),
+        state);
+}
