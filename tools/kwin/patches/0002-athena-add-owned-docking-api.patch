+QVariantMap pointToVariantMap(const QPointF &point)
+{
+    return {
+        {QStringLiteral("x"), point.x()},
+        {QStringLiteral("y"), point.y()},
+    };
+}
+
+QVariantMap rectToVariantMap(const RectF &rect)
+{
+    return {
+        {QStringLiteral("x"), rect.x()},
+        {QStringLiteral("y"), rect.y()},
+        {QStringLiteral("width"), rect.width()},
+        {QStringLiteral("height"), rect.height()},
+    };
+}
+
+QVariantMap outputToVariantMap(LogicalOutput *output)
+{
+    if (!output) {
+        return {};
+    }
+    return {
+        {QStringLiteral("name"), output->name()},
+        {QStringLiteral("uuid"), output->uuid()},
+        {QStringLiteral("geometry"), rectToVariantMap(output->geometryF())},
+        {QStringLiteral("scale"), output->scale()},
+        {QStringLiteral("transform"), int(output->transform().kind())},
+    };
+}
+}
+
+int DBusInterface::athenaCallerPid() const
+{
+    if (!calledFromDBus()) {
+        return -1;
+    }
+
+    const QDBusReply<uint> reply = connection().interface()->servicePid(message().service());
+    if (!reply.isValid()) {
+        return -1;
+    }
+    return int(reply.value());
+}
+
+Window *DBusInterface::athenaCallerWindow(const QString &uuid, int callerPid) const
+{
+    if (callerPid < 0) {
+        return nullptr;
+    }
+
+    const QUuid internalId = QUuid::fromString(uuid);
+    if (internalId.isNull()) {
+        return nullptr;
+    }
+
+    Window *window = workspace()->findWindow(internalId);
+    if (!window || !window->isClient() || window->pid() != callerPid) {
+        return nullptr;
+    }
+    return window;
+}
+
+Window *DBusInterface::athenaTargetWindowAt(int callerPid, Window *draggedWindow, const QPointF &point) const
+{
+    const QList<Window *> stack = workspace()->stackingOrder();
+    for (int i = stack.size() - 1; i >= 0; --i) {
+        Window *candidate = stack.at(i);
+        if (!candidate || candidate == draggedWindow || !candidate->isClient() || candidate->pid() != callerPid) {
+            continue;
+        }
+        if (candidate->isMinimized() || !candidate->frameGeometry().contains(point)) {
+            continue;
+        }
+        return candidate;
+    }
+    return nullptr;
+}
+
+QVariantMap DBusInterface::athenaWindowToVariantMap(Window *window) const
+{
+    QVariantMap result = {
+        {QStringLiteral("windowId"), window->internalId().toString()},
+        {QStringLiteral("pid"), window->pid()},
+        {QStringLiteral("caption"), window->captionNormal()},
+        {QStringLiteral("resourceClass"), window->resourceClass()},
+        {QStringLiteral("resourceName"), window->resourceName()},
+        {QStringLiteral("desktopFile"), window->desktopFileName()},
+        {QStringLiteral("frameGeometry"), rectToVariantMap(window->frameGeometry())},
+        {QStringLiteral("clientGeometry"), rectToVariantMap(window->clientGeometry())},
+        {QStringLiteral("output"), outputToVariantMap(window->output())},
+        {QStringLiteral("active"), window->isActive()},
+        {QStringLiteral("minimized"), window->isMinimized()},
+        {QStringLiteral("move"), window->isInteractiveMove()},
+        {QStringLiteral("resize"), window->isInteractiveResize()},
+    };
+    if (LogicalOutput *output = window->output()) {
+        result.insert(QStringLiteral("outputName"), output->name());
+        result.insert(QStringLiteral("outputGeometry"), rectToVariantMap(output->geometryF()));
+        result.insert(QStringLiteral("outputScale"), output->scale());
+    }
+    return result;
+}
+
+QVariantList DBusInterface::athenaListWindows()
+{
+    const int callerPid = athenaCallerPid();
+    QVariantList result;
+    if (callerPid < 0) {
+        return result;
+    }
+
+    const QList<Window *> windows = workspace()->windows();
+    for (Window *window : windows) {
+        if (!window || !window->isClient() || window->pid() != callerPid) {
+            continue;
+        }
+        result.push_back(athenaWindowToVariantMap(window));
+    }
+    return result;
+}
+
+bool DBusInterface::athenaSetWindowGeometry(const QString &uuid, int x, int y, int width, int height)
+{
+    Window *window = athenaCallerWindow(uuid, athenaCallerPid());
+    if (!window || width <= 0 || height <= 0) {
+        return false;
+    }
+    window->moveResize(RectF(QPointF(x, y), QSizeF(width, height)));
+    return true;
+}
+
+bool DBusInterface::athenaRaiseWindow(const QString &uuid)
+{
+    Window *window = athenaCallerWindow(uuid, athenaCallerPid());
+    if (!window) {
+        return false;
+    }
+    workspace()->raiseWindow(window);
+    workspace()->requestFocus(window);
+    return true;
+}
+
+QVariantMap DBusInterface::athenaDockDragState(const AthenaDockDragSession &session) const
+{
+    QVariantMap state = {
+        {QStringLiteral("dragId"), session.dragId},
+        {QStringLiteral("hotspot"), pointToVariantMap(session.hotspot)},
+    };
+
+    Window *dragged = session.draggedWindow;
+    if (!dragged) {
+        return state;
+    }
+
+    const QPointF pointer = input()->globalPointer();
+    LogicalOutput *output = workspace()->outputAt(pointer);
+    state.insert(QStringLiteral("pointerGlobal"), pointToVariantMap(pointer));
+    state.insert(QStringLiteral("output"), outputToVariantMap(output));
+    if (output) {
+        state.insert(QStringLiteral("outputName"), output->name());
+        state.insert(QStringLiteral("outputGeometry"), rectToVariantMap(output->geometryF()));
+        state.insert(QStringLiteral("outputScale"), output->scale());
+    }
+    state.insert(QStringLiteral("draggedWindowId"), dragged->internalId().toString());
+    state.insert(QStringLiteral("draggedFrameGeometry"), rectToVariantMap(dragged->frameGeometry()));
+    state.insert(QStringLiteral("draggedClientGeometry"), rectToVariantMap(dragged->clientGeometry()));
+
+    Window *target = athenaTargetWindowAt(session.callerPid, dragged, pointer);
+    if (target) {
+        state.insert(QStringLiteral("targetWindowId"), target->internalId().toString());
+        state.insert(QStringLiteral("targetFrameGeometry"), rectToVariantMap(target->frameGeometry()));
+        state.insert(QStringLiteral("targetClientGeometry"), rectToVariantMap(target->clientGeometry()));
+        state.insert(QStringLiteral("targetLocalClientPos"), pointToVariantMap(pointer - target->clientGeometry().topLeft()));
+    } else {
+        state.insert(QStringLiteral("targetWindowId"), QString());
+    }
+
+    return state;
+}
+
+void DBusInterface::athenaSendDockDragCallback(const AthenaDockDragSession &session, const QString &method, const QVariantMap &state) const
+{
+    if (session.service.isEmpty() || session.callbackPath.isEmpty()) {
+        return;
+    }
+    QDBusMessage callback = QDBusMessage::createMethodCall(
+        session.service,
+        session.callbackPath,
+        QStringLiteral("org.athena.KWinDockDragSink"),
+        method);
+    callback << state;
+    QDBusConnection::sessionBus().asyncCall(callback);
+}
