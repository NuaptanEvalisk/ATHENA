de tag="macro"><text>g</text><node tag="quasi"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="assign"><node tag="unquote"><node tag="merge"><text>display-in-</text><node tag="arg"><text>g</text></node></node></node><node tag="macro"><text>x</text><text>nr</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="unquote"><node tag="merge"><text>display-</text><node tag="arg"><text>g</text></node></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="merge"><text>ind-display-</text><node tag="arg"><text>x</text></node></node><node tag="arg"><text>nr</text></node></node></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>counter-in-</text><node tag="arg"><text>g</text></node></node></node><node tag="macro"><text>x</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="merge"><text>ind-counter-</text><node tag="arg"><text>x</text></node></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>reset-</text><node tag="arg"><text>g</text></node></node></node><node tag="macro"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="assign"><node tag="compound"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node><text>0</text></node><node tag="for-each"><text>reset-counter</text><node tag="value"><node tag="unquote"><node tag="merge"><node tag="arg"><text>g</text></node><text>-group</text></node></node></node></node></node></node></node></node></node></node></node></node></node><node tag="assign"><text>individual-counter</text><node tag="macro"><text>x</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="quasi"><node tag="assign"><node tag="unquote"><n