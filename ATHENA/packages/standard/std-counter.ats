<?xml version="1.0" encoding="UTF-8"?><athena-document version="1" text-model="utf-8"><node tag="document"><node tag="style"><node tag="tuple"><text>source</text><text>std</text><text>english</text></node></node><node tag="body"><node tag="document"><node tag="active*"><node tag="src-title"><node tag="document"><node tag="src-package"><text>std-counter</text><text>1.0</text></node><node tag="src-purpose"><node tag="document"><text>This package manages counters for sections, theorems, etc.</text></node></node><node tag="src-copyright"><text>2004</text><text>Joris van der Hoeven</text></node><node tag="src-license"><node tag="document"><node tag="concat"><text>This software falls under the </text><node tag="hlink"><text>GNU general public license, version 3 or later</text><text>$ATHENA_PATH/LICENSE</text></node><text>. It comes WITHOUT ANY WARRANTY WHATSOEVER. You should have received a copy of the license which the software. If not, see </text><node tag="hlink"><text>http://www.gnu.org/licenses/gpl-3.0.html</text><text>http://www.gnu.org/licenses/gpl-3.0.html</text></node><text>.</text></node></node></node></node></node></node><node tag="active*"><node tag="document"><node tag="src-comment"><node tag="document"><node tag="concat"><text>The </text><node tag="verbatim"><text>new-counter</text></node><text> primitive is used for the definition of a new counter. Each new counter </text><node tag="verbatim"><text>x</text></node><text> gives rise to several new environment variables:</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-nr</text></node><text>: the counter itself (an integer).</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>display-x</text></node><text>: a macro which will be applied to the counter for displaying it.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>counter-x</text></node><text>: a macro which returns the name of the counter (</text><node tag="verbatim"><text>x-nr</text></node><text> by default).</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>the-x</text></node><text>: a macro which returns the counter for display.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>reset-x</text></node><text>: a macro which resets the counter.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>inc-x</text></node><text>: a macro which increases the counter.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>next-x</text></node><text>: a macro which increases the counter and sets the current label to the counter.</text></node><text>The different macros may be changed in order to customize the behaviour of the counter; this feature is used in particular by the grouping primitives defined further below.</text></node></node></node></node><node tag="assign"><text>new-counter</text><node tag="macro"><text>x</text><node tag="quasi"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="assign"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-nr</text></node></node><text>0</text></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>display-</text><node tag="arg"><text>x</text></node></node></node><node tag="value"><text>identity</text></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node><node tag="macro"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-nr</text></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>the-</text><node tag="arg"><text>x</text></node></node></node><node tag="macro"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="unquote"><node tag="merge"><text>display-</text><node tag="arg"><text>x</text></node></node></node><node tag="value"><node tag="compound"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>reset-</text><node tag="arg"><text>x</text></node></node></node><node tag="macro"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="assign"><node tag="compound"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node><text>0</text></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>inc-</text><node tag="arg"><text>x</text></node></node></node><node tag="macro"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="assign"><node tag="compound"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node><node tag="plus"><node tag="value"><node tag="compound"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node></node><text>1</text></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>next-</text><node tag="arg"><text>x</text></node></node></node><node tag="macro"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="compound"><node tag="unquote"><node tag="merge"><text>inc-</text><node tag="arg"><text>x</text></node></node></node></node><node tag="set-binding"><node tag="compound"><node tag="unquote"><node tag="merge"><text>the-</text><node tag="arg"><text>x</text></node></node></node></node></node></node></node></node></node></node></node></node></node></node><node tag="assign"><text>value-counter</text><node tag="macro"><text>x</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node></node></node><node tag="assign"><text>reset-counter</text><node tag="macro"><text>x</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="merge"><text>reset-</text><node tag="arg"><text>x</text></node></node></node></node></node></node><node tag="assign"><text>inc-counter</text><node tag="macro"><text>x</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="merge"><text>inc-</text><node tag="arg"><text>x</text></node></node></node></node></node></node><node tag="assign"><text>next-counter</text><node tag="macro"><text>x</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="merge"><text>next-</text><node tag="arg"><text>x</text></node></node></node></node></node></node><node tag="active*"><node tag="document"><node tag="src-comment"><node tag="document"><node tag="concat"><text>Counters for similar environments (like </text><node tag="verbatim"><text>theorem</text></node><text>, </text><node tag="verbatim"><text>proposition</text></node><text>, etc.) can be grouped together from a logical point of view into ‘‘counter groups''. When using this feature, the different environments can either share a common counter (</text><node tag="verbatim"><text>group-common-counter</text></node><text>; ‘‘american style'') or continue to use their own counters (</text><node tag="verbatim"><text>group-individual-counters</text></node><text>; ‘‘european style''). When calling a macro like </text><node tag="verbatim"><text>reset-g</text></node><text> for a counter group </text><node tag="verbatim"><text>g</text></node><text>, all counters in the group are set to zero. Similarly, sectional prefixes can be shared by the environments in a group.</text></node></node></node></node></node><node tag="assign"><text>new-counter-group</text><node tag="macro"><text>g</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="assign"><node tag="merge"><node tag="arg"><text>g</text></node><text>-group</text></node><node tag="tuple"/></node><node tag="new-counter"><node tag="arg"><text>g</text></node></node><node tag="group-individual-counters"><node tag="arg"><text>g</text></node></node></node></node></node></node><node tag="assign"><text>add-to-counter-group</text><node tag="macro"><text>x</text><text>g</text><node tag="quasi"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="assign"><node tag="unquote"><node tag="merge"><node tag="arg"><text>g</text></node><text>-group</text></node></node><node tag="merge"><node tag="value"><node tag="merge"><node tag="arg"><text>g</text></node><text>-group</text></node></node><node tag="tuple"><node tag="arg"><text>x</text></node></node></node></node><node tag="new-counter"><node tag="arg"><text>x</text></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>ind-display-</text><node tag="arg"><text>x</text></node></node></node><node tag="value"><node tag="unquote"><node tag="merge"><text>display-</text><node tag="arg"><text>x</text></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>ind-counter-</text><node tag="arg"><text>x</text></node></node></node><node tag="value"><node tag="unquote"><node tag="merge"><text>counter-</text><node tag="arg"><text>x</text></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><text>display-</text><node tag="arg"><text>x</text></node></node></node><node tag="macro"><text>nr</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="unquote"><node tag="merge"><text>display-in-</text><node tag="arg"><text>g</text></node></node></node><node tag="unquote"><node tag="arg"><text>x</text></node></node><node tag="arg"><text>nr</text></node></node></node><