<?xml version="1.0" encoding="UTF-8"?>
<athena-document version="1" text-model="utf-8">
<node tag="document">
  <node tag="style"><text>source</text></node>
  <node tag="body"><node tag="document">
    <node tag="assign"><text>slide-page-types</text><node tag="tuple"><text>title</text><text>section</text><text>content</text><text>blank</text></node></node>
    <node tag="assign"><text>slide-default-type</text><text>blank</text></node>
    <node tag="assign"><text>slide-page-type-title</text><node tag="tuple">
      <text>Title</text><text>render-slide-title</text><node tag="tuple">
        <node tag="tuple"><text>title</text><text>Title</text><text/></node>
        <node tag="tuple"><text>subtitle</text><text>Subtitle</text><text/></node>
        <node tag="tuple"><text>author</text><text>Author</text><text/></node>
        <node tag="tuple"><text>date</text><text>Date</text><text/></node>
      </node>
    </node></node>
    <node tag="assign"><text>slide-page-type-section</text><node tag="tuple">
      <text>Section</text><text>render-slide-section</text><node tag="tuple">
        <node tag="tuple"><text>title</text><text>Title</text><text/></node>
        <node tag="tuple"><text>subtitle</text><text>Subtitle</text><text/></node>
      </node>
    </node></node>
    <node tag="assign"><text>slide-page-type-content</text><node tag="tuple">
      <text>Content</text><text>render-slide-content</text><node tag="tuple">
        <node tag="tuple"><text>title</text><text>Title</text><text/></node>
      </node>
    </node></node>
    <node tag="assign"><text>slide-page-type-blank</text><node tag="tuple">
      <text>Blank</text><text>render-slide-blank</text><node tag="tuple"/>
    </node></node>
    <node tag="assign"><text>slide-heading-size</text><text>2.4</text></node>
    <node tag="assign"><text>slide-cover-heading-size</text><text>3.6</text></node>
    <node tag="assign"><text>slide-cover-text-size</text><text>1.6</text></node>
    <node tag="assign"><text>slide-cover-par-sep</text><text>0.5fn</text></node>
    <node tag="assign"><text>render-slide-field</text><node tag="macro"><text>field</text><text>body</text>
      <node tag="with"><text>athena-radioactive-links-suppressed</text><text>true</text>
        <text>color</text><text>#222222</text>
        <text>ornament-shape</text><text>classic</text><text>ornament-color</text><text>#edf2ee</text>
        <text>ornament-border</text><text>1px</text><text>ornament-hpadding</text><text>0.35fn</text>
        <text>ornament-vpadding</text><text>0.05fn</text><text>ornament-sunny-color</text><text>#7d9685</text>
        <text>ornament-shadow-color</text><text>#7d9685</text>
        <node tag="ornament"><node tag="arg"><text>body</text></node></node>
      </node>
    </node></node>
    <node tag="assign"><text>slide-heading</text><node tag="macro"><text>body</text>
      <node tag="if"><node tag="equal"><node tag="arg"><text>body</text></node><text/></node><text/>
        <node tag="with"><text>font-series</text><text>bold</text>
          <text>font-size</text><node tag="value"><text>slide-heading-size</text></node>
          <node tag="arg"><text>body</text></node>
        </node>
      </node>
    </node></node>
    <node tag="assign"><text>slide-line</text><node tag="macro"><text>line</text><text>rest</text>
      <node tag="compound">
        <node tag="if"><node tag="equal"><node tag="arg"><text>line</text></node><text/></node>
          <text>slide-line-empty</text><text>slide-line-present</text>
        </node>
        <node tag="arg"><text>line</text></node><node tag="arg"><text>rest</text></node>
      </node>
    </node></node>
    <node tag="assign"><text>slide-line-empty</text><node tag="macro"><text>line</text><text>rest</text>
      <node tag="arg"><text>rest</text></node>
    </node></node>
    <node tag="assign"><text>slide-line-present</text><node tag="macro"><text>line</text><text>rest</text>
      <node tag="document"><node tag="concat"><node tag="arg"><text>line</text></node></node><node tag="arg"><text>rest</text></node></node>
    </node></node>
    <node tag="assign"><text>slide-centered</text><node tag="macro"><text>body</text>
      <node tag="tabular*"><node tag="tformat">
        <node tag="twith"><text>table-width</text><text>1par</text></node>
        <node tag="twith"><text>table-hmode</text><text>exact</text></node>
        <node tag="cwith"><text>1</text><text>1</text><text>1</text><text>1</text><text>cell-height</text><text>0.85pag</text></node>
        <node tag="cwith"><text>1</text><text>1</text><text>1</text><text>1</text><text>cell-vmode</text><text>max</text></node>
        <node tag="cwith"><text>1</text><text>1</text><text>1</text><text>1</text><text>cell-halign</text><text>c</text></node>
        <node tag="cwith"><text>1</text><text>1</text><text>1</text><text>1</text><text>cell-valign</text><text>c</text></node>
        <node tag="cwith"><text>1</text><text>1</text><text>1</text><text>1</text><text>cell-hyphen</text><text>t</text></node>
        <node tag="table"><node tag="row"><node tag="cell"><node tag="with">
          <text>par-mode</text><text>center</text><text>par-first</text><text>0fn</text>
          <text>font-size</text><node tag="value"><text>slide-cover-text-size</text></node>
          <text>slide-heading-size</text><node tag="value"><text>slide-cover-heading-size</text></node>
          <text>par-par-sep</text><node tag="value"><text>slide-cover-par-sep</text></node>
          <node tag="arg"><text>body</text></node>
        </node></node></node></node>
      </node></node>
    </node></node>
    <node tag="assign"><text>render-slide-title</text><node tag="macro">
      <text>title</text><text>subtitle</text><text>author</text><text>date</text><text>body</text>
      <node tag="slide-centered"><node tag="slide-line">
        <node tag="slide-heading"><node tag="arg"><text>title</text></node></node>
        <node tag="slide-line"><node tag="arg"><text>subtitle</text></node>
          <node tag="slide-line"><node tag="arg"><text>author</text></node>
            <node tag="slide-line"><node tag="arg"><text>date</text></node>
              <node tag="arg"><text>body</text></node>
            </node>
          </node>
        </node>
      </node></node>
    </node></node>
    <node tag="assign"><text>render-slide-section</text><node tag="macro">
      <text>title</text><text>subtitle</text><text>body</text>
      <node tag="slide-centered"><node tag="slide-line">
        <node tag="slide-heading"><node tag="arg"><text>title</text></node></node>
        <node tag="slide-line"><node tag="arg"><text>subtitle</text></node>
          <node tag="arg"><text>body</text></node>
        </node>
      </node></node>
    </node></node>
    <node tag="assign"><text>render-slide-content</text><node tag="macro"><text>title</text><text>body</text>
      <node tag="slide-line">
        <node tag="slide-heading"><node tag="arg"><text>title</text></node></node>
        <node tag="arg"><text>body</text></node>
      </node>
    </node></node>
    <node tag="assign"><text>render-slide-blank</text><node tag="macro"><text>body</text><node tag="arg"><text>body</text></node></node></node>
  </node></node>
</node>
</athena-document>
