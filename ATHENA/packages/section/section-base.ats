<?xml version="1.0" encoding="UTF-8"?><athena-document version="1" text-model="utf-8"><node tag="document"><node tag="style"><text>source</text></node><node tag="body"><node tag="document"><node tag="active*"><node tag="src-title"><node tag="document"><node tag="src-package"><text>section-base</text><text>1.0</text></node><node tag="src-purpose"><node tag="document"><node tag="concat"><text>The common base for most </text><node tag="TeXmacs"/><text> styles with sectional markup.</text></node></node></node><node tag="src-copyright"><text>1998--2004</text><text>Joris van der Hoeven</text></node><node tag="src-license"><node tag="document"><node tag="concat"><text>This software falls under the </text><node tag="hlink"><text>GNU general public license, version 3 or later</text><text>$ATHENA_PATH/LICENSE</text></node><text>. It comes WITHOUT ANY WARRANTY WHATSOEVER. You should have received a copy of the license which the software. If not, see </text><node tag="hlink"><text>http://www.gnu.org/licenses/gpl-3.0.html</text><text>http://www.gnu.org/licenses/gpl-3.0.html</text></node><text>.</text></node></node></node></node></node></node><node tag="use-module"><text>(link link-navigate)</text></node><node tag="active*"><node tag="document"><node tag="src-comment"><node tag="document"><text>Environment parameters.</text></node></node></node></node><node tag="assign"><text>sectional-sep</text><node tag="macro"><node tag="space"><text>2spc</text></node></node></node><node tag="assign"><text>sectional-post-sep</text><node tag="macro"><node tag="sectional-sep"/></node></node><node tag="assign"><text>sectional-short-style</text><node tag="macro"><text>true</text></node></node><node tag="drd-props"><text>sectional-sep</text><text>macro-parameter</text><text>regular</text></node><node tag="active*"><node tag="document"><node tag="src-comment"><node tag="document"><text>Names of special sections.</text></node></node></node></node><node tag="assign"><text>prologue-text</text><node tag