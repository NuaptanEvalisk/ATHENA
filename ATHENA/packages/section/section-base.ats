e</text><text>0</text></node><node tag="assign"><text>sectional-short</text><node tag="macro"><text>name</text><node tag="concat"><node tag="no-indent"/><node tag="arg"><text>name</text></node></node></node></node><node tag="assign"><text>sectional-normal</text><node tag="macro"><text>name</text><node tag="wide-normal"><node tag="concat"><node tag="arg"><text>name</text></node><node tag="no-page-break"/><node tag="sectional-no-indent"/></node></node></node></node><node tag="assign"><text>sectional-centered</text><node tag="macro"><text>name</text><node tag="wide-centered"><node tag="concat"><node tag="arg"><text>name</text></node><node tag="no-page-break"/><node tag="sectional-no-indent"/></node></node></node></node><node tag="assign"><text>sectional-short-italic</text><node tag="macro"><text>name</text><node tag="sectional-short"><node tag="with"><text>font-shape</text><text>italic</text><node tag="arg"><text>name</text></node></node></node></node></node><node tag="assign"><text>sectional-normal-italic</text><node tag="macro"><text>name</text><node tag="sectional-normal"><node tag="with"><text>font-shape</text><text>italic</text><node tag="arg"><text>name</text></node></node></node></node></node><node tag="assign"><text>sectional-centered-italic</text><node tag="macro"><text>name</text><node tag="sectional-centered"><node tag="with"><text>font-shape</text><text>italic</text><node tag="arg"><text>name</text></node></node></node></node></node><node tag="assign"><text>sectional-short-bold</text><node tag="macro"><text>name</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="sectional-short"><node tag="strong"><node tag="arg"><text>name</text></node></node></node></node></node></node><node tag="assign"><text>sectional-normal-bold</text><node tag="macro"><text>name</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="sectional-normal"><node tag="strong"><node tag="arg"><text>name</text></node></node></node></node></node></node><node tag="assign"><text>sectional-centered-bold</text><node tag="macro"><text>name</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="sectional-centered"><node tag="strong"><node tag="arg"><text>name</text></node></node></node></node></node></node><node tag="assign"><text>sectional-prefixed</text><node tag="macro"><text>prefix</text><text>name</text><node tag="prefixed-line"><node tag="arg"><text>prefix</text></node><node tag="arg"><text>name</text></node></node></node></node><node tag="assign"><text>tmhtml-sectional-prefixed</text><node tag="macro"><text>prefix</text><text>name</text><node tag="concat"><node tag="arg"><text>prefix</text></node><node tag="arg"><text>name</text></node></node></node></node><node tag="active*"><node tag="document"><node tag="src-comment"><node tag="document"><node tag="concat"><text>The </text><node tag="verbatim"><text>new-section</text></node><text> primitive is used for the definition of a new sectional tag. Each new sectional tag </text><node tag="verbatim"><text>x</text></node><text> gives rise to a corresponding sectional counter and several additional environment variables:</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x</text></node><text>: for numbered sections.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x*</text></node><text>: for unnumbered sections.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-text</text></node><text>: section text like Chapter, Section, etc. By the default, the first character of </text><node tag="verbatim"><text>x</text></node><text> is upcased.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-numbered</text></node><text>: flag for knowing whether the last section is numbered or not.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-prefix</text></node><text>: macro for displaying the section number as a prefix (for subsection numbers).</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-title</text></node><text>: a macro for displaying the title of the section.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-unnumbered-title</text></node><text>: a macro for displaying an unnumbered title (including an optinal separator).</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-numbered-title</text></node><text>: a macro for displaying a numbered title (including an optinal separator).</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-display-numbers</text></node><text>: predicate for testing whether the section numbers should be displayed.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-sep</text></node><text>: the separator between the number of a title and the title itself.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-post-sep</text></node><text>: an optional separator between the title and the body of the section.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-clean</text></node><text>: a macro for additional cleaning up (used for resetting standard environments and </text><node tag="verbatim"><text>appendix</text></node><text>).</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-header</text></node><text>: a macro for setting the header.</text></node><node tag="concat"><text>  </text><node tag="verbatim"><text>x-toc</text></node><text>: a macro for entering the section in the table of contents.</text></node><node tag="concat"><text>All macros are set to reasonable defaults, but they may be customized afterwards. The flag </text><node tag="verbatim"><text>x-numbered</text></node><text> and the macro </text><node tag="verbatim"><text>x-prefix</text></node><text> are set in the bodies of </text><node tag="verbatim"><text>x</text></node><text> and </text><node tag="verbatim"><text>x*</text></node><text>, so they cannot be customized. Nevertheless, it may sometimes be useful to change the </text><node tag="verbatim"><text>x-prefix</text></node><text> tag inside macros, as we do in the case of </text><node tag="verbatim"><text>appendix</text></node><text>.</text></node></node></node></node></node><node tag="assign"><text>new-section</text><node tag="macro"><text>x</text><node tag="quasi"><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="new-counter"><node tag="unquote"><node tag="arg"><text>x</text></node></node></node><node tag="drd-props"><node tag="unquote"><node tag="arg"><text>x</text></node></node><text>arity</text><text>1</text><text>accessible</text><text>0</text></node><node tag="drd-props"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>*</text></node></node><text>arity</text><text>1</text><text>accessible</text><text>0</text></node><node tag="assign"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-text</text></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="macro"><node tag="change-case"><node tag="localize"><node tag="unquote"><node tag="arg"><text>x</text></node></node></node><text>Upcase</text></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="arg"><text>x</text></node></node><node tag="macro"><text>title</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="concat"><node tag="assign"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-numbered</text></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-display-numbers</text></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-prefix</text></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="macro"><node tag="concat"><node tag="compound"><node tag="unquote"><node tag="merge"><text>the-</text><node tag="arg"><text>x</text></node></node></node></node><text>.</text></node></node></node></node><node tag="compound"><node tag="unquote"><node tag="merge"><text>next-</text><node tag="arg"><text>x</text></node></node></node></node><node tag="compound"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-clean</text></node></node></node><node tag="compound"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-header</text></node></node><node tag="arg"><text>title</text></node></node><node tag="compound"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-toc</text></node></node><node tag="arg"><text>title</text></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="if"><node tag="value"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-numbered</text></node></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-numbered-title</text></node></node><node tag="heading-fold-title"><node tag="arg"><text>title</text></node></node></node></node><node tag="style-with"><text>src-compact</text><text>none</text><node tag="compound"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>-unnumbered-title</text></node></node><node tag="heading-fold-title"><node tag="arg"><text>title</text></node></node></node></node></node></node></node></node></node></node><node tag="assign"><node tag="unquote"><node tag="merge"><node tag="arg"><text>x</text></node><text>*</text></node></node><node tag="macro"><text>title</text><node tag="style-with"><text>src-compact</text><text>none</text><node tag="c