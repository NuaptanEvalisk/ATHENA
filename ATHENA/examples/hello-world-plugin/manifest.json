{
  "schema": 2,
  "id": "example.hello-world",
  "name": "Hello World",
  "version": "2.0",
  "description": "Insert a Hello, World! paragraph using the Python AUDMAP v2 SDK.",
  "executable": "runtime/bin/python3.13",
  "arguments": ["-I", "plugin_exec"],
  "license": {"format": "text", "file": "LICENSE.txt"},
  "commands": [
    {"id": "insert-hello-world", "title": "Insert Hello World", "parameters": {}}
  ],
  "permissions": {
    "jail": [],
    "audmap": [
      {"resource": "buffer", "actions": ["resolve"], "required": true},
      {"resource": "document", "actions": ["resolve"], "required": true},
      {"resource": "node", "actions": ["resolve", "get", "insert"], "required": true}
    ]
  }
}
