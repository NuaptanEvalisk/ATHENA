  "semantics": {
    "numbered": "Whether the source environment requests automatic numbering; a render title is retained verbatim and never re-numbered.",
    "numbering_preference": "Caller-supplied effective value; without it conversion leaves this legacy node unchanged.",
    "starred_tag": "Explicit unnumbered alias with the same layout and variant, independent of numbering preferences.",
    "layout": "body: one body; title-body: complete title and body; subject-body: explicit subject and body. The latter two preserve child zero as rich-text name.",
    "title_mode": "Legacy display convention only, not permission to extract a name from body text.",
    "legacy-tag": "Conversion provenance for exact render style and title/subject interpretation; no proof-target inference.",
    "category": "Retains existing artifact categories where classified; other kinds receive descriptive categories.",
    "extensions": "Unknown declaration fields and unknown node properties remain intact. Unknown canonical kinds are opaque source content."
  },
