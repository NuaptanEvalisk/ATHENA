{
  "version": 1,
  "formats": [
    {"id": "texmacs", "name": "ATHENA", "suffixes": ["ath"],
     "recognizer": "athena", "must_recognize": true},
    {"id": "stm", "name": "ATHENA Scheme", "suffixes": ["ascm", "stm"],
     "recognizer": "prefix", "must_recognize": true,
     "signatures": ["(document (TeXmacs"]},
    {"id": "code", "name": "Source code"},
    {"id": "verbatim", "name": "Verbatim"},
    {"id": "latex", "name": "LaTeX", "suffixes": ["tex"],
     "recognizer": "prefix", "ignore_case": true, "skip_whitespace": true,
     "signatures": ["\\document", "\\usepackage", "\\input", "\\includeonly", "\\chapter", "\\appendix", "\\section", "\\begin"]},
    {"id": "latex-class", "name": "LaTeX class", "suffixes": ["ltx", "sty", "cls"]},
    {"id": "html", "name": "HTML", "suffixes": ["html", "htm"],
     "recognizer": "html", "ignore_case": true, "skip_whitespace": true,
     "signatures": ["<html", "<xhtml", "<body", "<title", "<!doctype html", "<math"]},
    {"id": "mathml-v3", "name": "MathML (native v3)"},
    {"id": "markdown", "name": "Markdown", "suffixes": ["md"]},
    {"id": "chatgpt", "name": "ChatGPT"},
    {"id": "pdf", "name": "PDF", "suffixes": ["pdf"], "image": true},
    {"id": "svg", "name": "SVG", "suffixes": ["svg"], "image": true},
    {"id": "jpeg", "name": "JPEG", "suffixes": ["jpg", "jpeg"], "image": true},
    {"id": "tif", "name": "TIFF", "suffixes": ["tif", "tiff"], "image": true},
    {"id": "ppm", "name": "PPM", "suffixes": ["ppm"], "image": true},
    {"id": "gif", "name": "GIF", "suffixes": ["gif"], "image": true},
    {"id": "png", "name": "PNG", "suffixes": ["png"], "image": true},
    {"id": "pnm", "name": "PNM", "suffixes": ["pnm"], "image": true},
    {"id": "cpp", "name": "C++ source code"},
    {"id": "julia", "name": "Julia source code"},
    {"id": "java", "name": "Java source code"},
    {"id": "scala", "name": "Scala source code"},
    {"id": "json", "name": "JSON"},
    {"id": "csv", "name": "CSV"},
    {"id": "python", "name": "Python source code"}
  ]
}
