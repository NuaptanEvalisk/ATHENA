{
  "choose-file": {"interactive": true},
  "load-buffer": {"arguments": [{"name": "name", "type": "smart-file", "label": "File name", "default": "propose-name-buffer"}], "rest": "opts"},
  "load-buffer-in-new-window": {"arguments": [{"name": "name", "type": "smart-file", "label": "File name", "default": "propose-name-buffer"}], "rest": "opts"},
  "load-document": {"arguments": [{"name": "u", "type": "smart-file", "label": "File name", "default": "propose-name-buffer"}]},
  "load-document*": {"arguments": [{"name": "u", "type": "smart-file", "label": "File name", "default": "propose-name-buffer"}]},
  "switch-document": {"arguments": [{"name": "u", "type": "smart-file", "label": "File name", "default": "propose-name-buffer"}]},
  "open-replace": {"interactive": true},
  "make-with": {"check-mark": ["o", "test-env?"]},
  "make-line-with": {"synopsis": "Make 'with' with one or more paragraphs as its scope", "check-mark": ["o", "test-env?"]},
  "make-interactive-with": {"interactive": true},
  "make-interactive-line-with": {"interactive": true},
  "make-interactive-with-opacity": {"interactive": true},
