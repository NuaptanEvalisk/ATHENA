  "make-var-space": {"synopsis": "Insert rigid space", "arguments": [{"name": "spc", "label": "Horizontal space"}, {"name": "base", "label": "Base level"}, {"name": "top", "label": "Top level"}]},
  "make-htab": {"synopsis": "Insert horizontal tab", "arguments": [{"name": "spc", "label": "Minimal space"}]},
  "make-vspace-before": {"synopsis": "Insert space before", "arguments": [{"name": "spc", "label": "Vertical space"}]},
  "make-vspace-after": {"synopsis": "Insert space after", "arguments": [{"name": "spc", "label": "Vertical space"}]},
  "set-effect-pen": {"check-mark": ["*", "test-effect-pen?"]},
  "make-move": {"arguments": [{"name": "hor", "label": "Horizontal"}, {"name": "ver", "label": "Vertical"}]},
  "make-shift": {"arguments": [{"name": "hor", "label": "Horizontal"}, {"name": "ver", "label": "Vertical"}]},
  "make-resize": {"arguments": [{"name": "l", "label": "Left"}, {"name": "b", "label": "Bottom"}, {"name": "r", "label": "Right"}, {"name": "t", "label": "Top"}]},
  "make-extend": {"arguments": [{"name": "l", "label": "Left"}, {"name": "b", "label": "Bottom"}, {"name": "r", "label": "Right"}, {"name": "t", "label": "Top"}]},
  "make-clipped": {"arguments": [{"name": "l", "label": "Left"}, {"name": "b", "label": "Bottom"}, {"name": "r", "label": "Right"}, {"name": "t", "label": "Top"}]},
  "make-reduce-by": {"arguments": [{"name": "by", "label": "Reduce by"}]},
  "open-paragraph-format": {"interactive": true},
  "open-page-format": {"interactive": true, "applicable": "page-format-applicable?"},
  "open-pattern-selector": {"interactive": true},
  "open-gradient-selector": {"interactive": true},
  "open-background-picture-selector": {"interactive": true},
  "open-shortcuts-editor": {"interactive": true},
  "open-font-selector": {"interactive": true},
  "open-document-font-selector": {"interactive": true},
  "open-document-other-font-selector": {"interactive": true}
