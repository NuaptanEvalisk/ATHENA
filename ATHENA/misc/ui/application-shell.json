{
  "version": 2,
  "commands": [
    {
      "id": "application.new-document",
      "label": "New document",
      "category": "File",
      "icon": "document-new",
      "help": "Create a new ATHENA document",
      "shortcut": "Ctrl+N"
    },
    {
      "id": "application.open",
      "label": "Open document...",
      "category": "File",
      "icon": "document-open",
      "help": "Open a document from disk",
      "shortcut": "Ctrl+O"
    },
    {
      "id": "application.preferences",
      "label": "Preferences...",
      "category": "File",
      "icon": "preferences-system",
      "help": "Open ATHENA preferences"
    },
    {
      "id": "application.command-palette",
      "label": "Command palette...",
      "category": "Go",
      "icon": "system-search",
      "help": "Search commands available in the current work context",
      "shortcut": "Ctrl+Shift+P"
    },
    {
      "id": "application.quit",
      "label": "Quit",
      "category": "File",
      "icon": "application-exit",
      "help": "Quit ATHENA safely",
      "shortcut": "Ctrl+Q"
    },
    {
      "id": "workspace.namespace-explorer",
      "label": "Namespace Explorer",
      "category": "Workspace",
      "icon": "view-list-tree",
      "help": "Show the Namespace Explorer pane"
    },
    {
      "id": "view.error-messages",
      "label": "Error messages",
      "category": "View",
      "icon": "dialog-error",
      "help": "Show the shared Error Messages pane"
    },
    {
      "id": "view.artifacts",
      "label": "Artifacts",
      "category": "View",
      "icon": "view-list-details",
      "help": "Show artifacts for the active vault"
    },
    {
      "id": "view.outline",
      "label": "Outline",
      "category": "View",
      "icon": "view-list-tree",
      "help": "Show the outline for the last active document"
    },
    {
      "id": "view.neighborhoods",
      "label": "Neighborhoods",
      "category": "View",
      "icon": "view-list-icons",
      "help": "Show neighborhoods for the last active vault document"
    },
    {
      "id": "view.document-history",
      "label": "Document History",
      "category": "View",
      "icon": "document-open-recent",
      "help": "Show history for the document captured by the current context"
    },
    {
      "id": "workspace.global-search",
      "label": "Global search",
      "category": "Edit",
      "icon": "edit-find",
      "help": "Search across the active vault"
    },
    {
      "id": "file.compare-files",
      "label": "Compare two files",
      "category": "File",
      "icon": "document-compare",
      "help": "Compare two ATHENA documents"
    },
    {
      "id": "file.export-namespace",
      "label": "Export namespace",
      "category": "File",
      "icon": "document-export",
      "help": "Export a namespace from the active vault"
    },
    {
      "id": "application.quick-switcher",
      "label": "Quick switcher",
      "category": "Go",
      "icon": "system-search",
      "help": "Switch quickly among vault documents"
    },
    {
      "id": "workspace.namespace-manager",
      "label": "Namespace Manager",
      "category": "Workspace",
      "icon": "view-list-tree",
      "help": "Open the Namespace Manager"
    },
    {
      "id": "workspace.websites-manager",
      "label": "Websites manager",
      "category": "Workspace",
      "icon": "applications-internet",
      "help": "Open the Websites manager"
    },
    {
      "id": "workspace.materials-manager",
      "label": "Materials manager",
      "category": "Workspace",
      "icon": "folder-documents",
      "help": "Open the Materials manager"
    },
    {
      "id": "workspace.custom-styles-manager",
      "label": "Custom styles manager",
      "category": "Workspace",
      "icon": "preferences-desktop-theme",
      "help": "Open the Custom styles manager"
    },
    {
      "id": "workspace.audmap-repl",
      "label": "AUDMAP REPL",
      "category": "Workspace",
      "icon": "utilities-terminal",
      "help": "Open the AUDMAP REPL pane"
    },
    {
      "id": "workspace.google-tasks",
      "label": "Google Tasks",
      "category": "Workspace",
      "icon": "view-task",
      "help": "Open the Google Tasks pane"
    },
    {
      "id": "workspace.artifacts-build-vault",
      "label": "Build entire vault",
      "category": "Workspace",
      "icon": "system-run",
      "help": "Rebuild artifacts for the active vault"
    },
    {
      "id": "help.about",
      "label": "About ATHENA...",
      "category": "Help",
      "icon": "help-about",
      "help": "Show ATHENA version and technical information"
    },
    {
      "id": "editor.undo",
      "label": "Undo",
      "category": "Edit",
      "icon": "edit-undo",
      "help": "Undo the most recent editor change"
    },
    {
      "id": "editor.redo",
      "label": "Redo",
      "category": "Edit",
      "icon": "edit-redo",
      "help": "Redo the most recently undone editor change"
    },
    {
      "id": "editor.copy",
      "label": "Copy",
      "category": "Edit",
      "icon": "edit-copy",
      "help": "Copy the current editor selection"
    },
    {
      "id": "editor.cut",
      "label": "Cut",
      "category": "Edit",
      "icon": "edit-cut",
      "help": "Cut the current editor selection"
    },
    {
      "id": "editor.paste",
      "label": "Paste",
      "category": "Edit",
      "icon": "edit-paste",
      "help": "Paste into the active editor"
    },
    {
      "id": "editor.node-properties",
      "label": "Node properties...",
      "category": "Focus",
      "icon": "document-properties",
      "help": "Inspect or edit properties of the focused structured node"
    },
    {
      "id": "namespace.open",
      "label": "Open selected item",
      "category": "Namespace Explorer",
      "icon": "document-open",
      "help": "Open the selected file or expand the selected namespace"
    },
    {
      "id": "namespace.copy",
      "label": "Copy selected file",
      "category": "Namespace Explorer",
      "icon": "edit-copy",
      "help": "Copy the selected namespace file"
    },
    {
      "id": "namespace.paste",
      "label": "Paste near selection",
      "category": "Namespace Explorer",
      "icon": "edit-paste",
      "help": "Paste the copied namespace file near the selection"
    },
    {
      "id": "namespace.rename",
      "label": "Rename selected file...",
      "category": "Namespace Explorer",
      "icon": "edit-rename",
      "help": "Rename the selected namespace file"
    },
    {
      "id": "namespace.delete",
      "label": "Delete selected file...",
      "category": "Namespace Explorer",
      "icon": "edit-delete",
      "help": "Delete or move the selected namespace file to Trash"
    },
    {
      "id": "namespace.refresh",
      "label": "Refresh Namespace Explorer",
      "category": "Namespace Explorer",
      "icon": "view-refresh",
      "help": "Refresh namespace and file data"
    }
  ],
  "menus": [
    {
      "id": "file",
      "label": "&File",
      "items": [
        { "command": "application.new-document" },
        { "command": "application.open" },
        { "command": "file.compare-files" },
        { "separator": true },
        { "command": "file.export-namespace" },
        { "separator": true },
        { "command": "application.preferences" },
        { "separator": true },
        { "command": "application.quit" }
      ]
    },
    {
      "id": "edit",
      "label": "Edit",
      "items": [
        { "command": "editor.undo" },
        { "command": "editor.redo" },
        { "separator": true },
        { "command": "editor.copy" },
        { "command": "editor.cut" },
        { "command": "editor.paste" },
        { "separator": true },
        { "command": "workspace.global-search" },
        { "separator": true },
        { "command": "namespace.copy" },
        { "command": "namespace.paste" },
        { "separator": true },
        { "command": "namespace.rename" },
        { "command": "namespace.delete" }
      ]
    },
    {
      "id": "focus",
      "label": "Focus",
      "items": [
        { "command": "editor.node-properties" },
        { "separator": true },
        { "command": "namespace.open" },
        { "command": "namespace.refresh" }
      ]
    },
    {
      "id": "view",
      "label": "View",
      "items": [
        { "command": "view.outline" },
        { "command": "view.document-history" },
        { "command": "view.neighborhoods" },
        { "separator": true },
        { "command": "view.error-messages" },
        { "command": "view.artifacts" }
      ]
    },
    {
      "id": "workspace",
      "label": "Workspace",
      "items": [
        { "command": "workspace.namespace-explorer" },
        { "command": "workspace.namespace-manager" },
        {
          "submenu": "workspace-managers",
          "label": "Managers",
          "items": [
            { "command": "workspace.websites-manager" },
            { "command": "workspace.materials-manager" },
            { "command": "workspace.custom-styles-manager" }
          ]
        },
        {
          "submenu": "workspace-artifacts",
          "label": "Artifacts",
          "items": [
            { "command": "view.artifacts" },
            { "command": "workspace.artifacts-build-vault" }
          ]
        },
        { "separator": true },
        { "command": "workspace.audmap-repl" },
        { "command": "workspace.google-tasks" }
      ]
    },
    {
      "id": "go",
      "label": "Go",
      "items": [
        { "command": "application.command-palette" },
        { "command": "application.quick-switcher" }
      ]
    },
    {
      "id": "help",
      "label": "Help",
      "items": [
        { "command": "help.about" }
      ]
    }
  ]
}
