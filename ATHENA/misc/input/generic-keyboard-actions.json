  "handwriting": {
    "command_prefix": "\\",
    "description_suffix": "  Enter",
    "direct_unprefixed": true,
    "direct_text": {
      "\\--": "-",
      "\\---": "--",
      "\\----": "---"
    }
  },
  "escape_rules": [
    {
      "prefix": "tree:math-up:",
      "action": {
        "kind": "tree",
        "value": [
          "math-up",
          {
