{
  "version": 1,
  "escape_actions": {
    "tree:dx": {
      "kind": "tree",
      "value": [
        "frac",
        [
          "named-symbol",
          "texmacs:mathd"
        ],
        [
          "concat",
          [
            "named-symbol",
            "texmacs:mathd"
          ],
          "x"
        ]
      ]
    },
    "tree:dt": {
      "kind": "tree",
      "value": [
        "frac",
        [
          "named-symbol",
          "texmacs:mathd"
        ],
        [
          "concat",
          [
            "named-symbol",
            "texmacs:mathd"
          ],
          "t"
        ]
      ]
    },
    "tree:inv": {
      "kind": "superscript",
      "value": "-1"
    },
    "tree:op": {
      "kind": "superscript",
      "value": [
        "math-variant",
        "rm",
        "op"
      ]
    },
    "tree:id": {
      "kind": "tree",
      "value": [
        "math-variant",
        "rm",
        "id"
      ]
    },
    "tree:const": {
      "kind": "tree",
      "value": [
        "math-variant",
        "rm",
        "const"
      ]
    },
    "tree:varinjlim": {
      "kind": "accent",
      "stretch": true,
      "value": [
        "math-accent",
        "⃗",
        "u",
        "lim"
      ]
    },
    "tree:varprojlim": {
      "kind": "accent",
      "stretch": true,
      "value": [
        "math-accent",
        "⃖",
        "u",
        "lim"
      ]
    },
    "tree:bij": {
      "kind": "tree",
      "value": [
        "math-annotation",
        [
          "named-symbol",
          "texmacs:longrightarrow"
        ],
        "",
        "1:1"
      ]
    },
    "tree:simto": {
      "kind": "tree",
      "value": [
        "math-annotation",
        [
          "named-symbol",
          "texmacs:longrightarrow"
        ],
        "",
        [
          "named-symbol",
          "texmacs:sim"
        ]
      ]
    },
    "tree:lim-n-infty": {
      "kind": "scripts",
      "placement": "d",
      "value": [
        "scripts",
        "lim",
        "",
        "",
        [
          "concat",
          "n",
          [
            "named-symbol",
            "texmacs:rightarrow"
          ],
          [
            "named-symbol",
            "texmacs:infty"
          ]
        ],
        ""
      ]
    },
    "tree:varphi": {
      "kind": "tree",
      "value": [
        "concat",
        [
          "named-symbol",
          "texmacs:varphi"
        ]
      ]
    },
    "tree:rel": {
      "kind": "tree",
      "value": [
        "concat",
        [
          "space",
          "0.27em"
        ],
        "rel"
      ]
    },
    "tree:angle-brackets": {
      "kind": "scheme-call",
      "function": "make-bracket-open",
      "args": [
        "⟨",
        "⟩"
      ]
    },
    "tree:norm-brackets": {
      "kind": "scheme-call",
      "function": "make-bracket-open",
      "args": [
        "‖",
        "‖"
      ]
    },
    "tree:math-ss": {
      "kind": "variant",
      "value": "ss"
    },
    "tree:math-bf": {
      "kind": "variant",
      "value": "bf"
    },
    "tree:math-boldsymbol": {
      "kind": "variant",
      "value": "mbf"
    },
    "tree:math-frak": {
      "kind": "variant",
      "value": "frak"
    },
    "tree:math-scr": {
      "kind": "variant",
      "value": "cal"
    },
    "tree:q3": {
      "kind": "tree",
      "value": [
        "concat",
        [
          "space",
          "1em"
        ],
        [
          "space",
          "1em"
        ],
        [
          "space",
          "1em"
        ]
      ]
    }
  },
  "handwriting": {
    "command_prefix": "\\",
    "description_suffix": "  Enter",
    "direct_unprefixed": true,
    "direct_text": {
      "\\--": "-",
      "\\---": "--",
      "\\----": "---"
    }
  },
  "escape_rules": [
    {
      "prefix": "bbb-",
      "action": {
        "kind": "alphabet",
        "tag": "math-alpha-bbb",
        "value": {
          "capture": "suffix"
        }
      }
    },
    {
      "prefix": "tree:math-up:",
      "action": {
        "kind": "tree",
        "value": [
          "math-variant",
          "rm",
          {
            "capture": "suffix"
          }
        ]
      }
    },
    {
      "prefix": "tree:operator:",
      "action": {
        "kind": "text",
        "value": {
          "capture": "suffix"
        }
      }
    }
  ]
}
