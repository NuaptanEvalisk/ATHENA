{
  "version": 2,
  "string_encoding": "utf-8",
  "groups": [
    {
      "require": {"all": [{"call": "in-graphics?", "args": []}, {"not": {"call": "in-commutative-diagram?", "args": []}}, {"equal": [{"call": "get-env", "args": ["preamble"]}, "false"]}]},
      "bindings": [
        {"key": "#", "commands": [{"call": "native-graphics-grid-command", "args": ["toggle-both", "", true]}]},
        {"key": "return", "commands": [{"call": "graphics-apply-props-at-mouse", "args": []}]},
        {"key": "S-return", "commands": [{"call": "graphics-get-props-at-mouse", "args": []}]},
        {"key": "C-g", "commands": [{"call": "native-graphics-grid-command", "args": ["toggle", "", false]}]},
        {"key": "C-G", "commands": [{"call": "native-graphics-grid-command", "args": ["toggle", "", true]}]},
        {"key": "C-2", "commands": [{"call": "graphics-grid-subdivisions", "args": [2]}]},
        {"key": "C-3", "commands": [{"call": "graphics-grid-subdivisions", "args": [3]}]},
        {"key": "C-4", "commands": [{"call": "graphics-grid-subdivisions", "args": [4]}]},
        {"key": "C-5", "commands": [{"call": "graphics-grid-subdivisions", "args": [5]}]},
        {"key": "C-6", "commands": [{"call": "graphics-grid-subdivisions", "args": [6]}]},
        {"key": "C-7", "commands": [{"call": "graphics-grid-subdivisions", "args": [7]}]},
        {"key": "C-8", "commands": [{"call": "graphics-grid-subdivisions", "args": [8]}]},
        {"key": "C-9", "commands": [{"call": "graphics-grid-subdivisions", "args": [9]}]},
        {"key": "C-0", "commands": [{"call": "graphics-grid-subdivisions", "args": [10]}]},
        {"key": "C-left", "commands": [{"call": "graphics-rotate", "args": [{"number": -0.1}, true]}]},
        {"key": "C-right", "commands": [{"call": "graphics-rotate", "args": [{"number": 0.1}, true]}]},
        {"key": "C-up", "commands": [{"call": "graphics-rotate", "args": [{"number": 0.1}, false]}]},
        {"key": "C-down", "commands": [{"call": "graphics-rotate", "args": [{"number": -0.1}, false]}]}
      ]
    }
  ]
}
