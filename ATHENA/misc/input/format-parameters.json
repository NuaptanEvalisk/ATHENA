{
  "version": 1,
  "inhibit_global": ["item-tag", "enum-tag"],
  "inhibit_local": ["item-1", "item-2", "item-3", "item-4", "enum-1", "enum-2", "enum-3", "enum-4"],
  "focus_no_preferences": ["doc-note", "author-note"],
  "focus_preferences": ["reference", "pageref", "eqref", "smart-ref", "hlink", "locus", "ornament", "float", "around", "around*"],
  "focus_names": {"math": "Inline formula", "wide": "Wide", "wide*": "Wide", "around": "Around", "around*": "Around", "abstract": "Abstract text"},
  "focus_variants": {"lsub": ["lsub", "lsup"], "lsup": ["lsub", "lsup"], "rsub": ["rsub", "rsup"], "rsup": ["rsub", "rsup"], "wide": ["wide"], "wide*": ["wide"], "around": ["around"], "around*": ["around"]},
  "standard_options": {
    "tit": {"packages": ["framed-title", "title-bar"]},
    "math": {"recurse": true, "packages": ["number-long-article", "math-check"]},
    "math-colored": {"packages": ["math-ss"]},
    "around": {"packages": ["math-brackets"]},
    "around*": {"packages": ["math-brackets"]}
  },
  "standard_option_rules": [
    {"groups": ["list-tag"], "packages": ["compact-list", "triangle-list", "prefix-enumerations"]},
    {"groups": ["enunciation-tag", "render-enunciation-tag"], "tags": ["proof", "render-proof", "proof-alternative", "render-proof-alternative", "proof-standard", "render-proof-standard"], "packages": ["number-europe", "number-long-article", "framed-theorems", "hanging-theorems"]},
    {"groups": ["algorithm-tag"], "packages": ["centered-program", "framed-program"]},
    {"groups": ["small-figure-tag", "big-figure-tag"], "numbered_variants": true, "packages": ["captions-above"]}
  ],
  "standard": {
    "itemize": {"prepend": ["itemize-levels", "item-tag", "item-1", "item-2", "item-3", "item-4"], "inherit": "itemize-1", "exclude": ["itemize-level"]},
    "enumerate": {"prepend": ["enumerate-levels", "enum-tag", "enum-1", "enum-2", "enum-3", "enum-4"], "inherit": "enumerate-1", "exclude": ["enumerate-level"]},
    "action": ["locus-color"],
    "locus": ["locus-color", "visited-color"],
    "ornament": ["ornament-shape", "ornament-title-style", "ornament-border", "ornament-corner", "ornament-hpadding", "ornament-vpadding", "ornament-color", "ornament-extra-color", "ornament-sunny-color", "ornament-shadow-color"],
    "reference": [], "pageref": [], "eqref": [], "smart-ref": [], "label": [], "tag": [],
    "float": ["page-float-sep"]
  },
  "customizable": [
    {"tags": ["padded", "padded-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"]]},
    {"tags": ["overlined", "overlined-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["overlined-sep", "Inner"]]},
    {"tags": ["underlined", "underlined-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["underlined-sep", "Inner"]]},
    {"tags": ["leftlined", "leftlined-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["leftlined-sep", "Inner"]]},
    {"tags": ["rightlined", "rightlined-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["rightlined-sep", "Inner"]]},
    {"tags": ["bothlined", "bothlined-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["overlined-sep", "Top"], ["underlined-sep", "Bottom"]]},
    {"tags": ["verticallined", "verticallined-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["leftlined-sep", "Left"], ["rightlined-sep", "Right"]]},
    {"tags": ["framed", "framed-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["framed-color", "Color"]]},
    {"tags": ["ornamented", "decorated"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["ornament-vpadding", "Inner"], ["ornament-hpadding", "Indentation"], ["ornament-shape", "Shape"], ["ornament-color", "Color"], ["ornament-border", "Border"]]},
    {"tags": ["ornamented-titled", "decorated-titled"], "parameters": [["padding-above", "Above"], ["padding-below", "Below"], ["ornament-vpadding", "Inner"], ["ornament-hpadding", "Indentation"], ["ornament-shape", "Shape"], ["ornament-color", "Color"], ["ornament-border", "Border"], ["ornament-title-style", "Title style"], ["ornament-extra-color", "Title color"]]},
    {"tags": ["ornament"], "parameters": [["ornament-shape", "Shape"], ["ornament-color", "Color"], ["ornament-title-style", "Title style"], ["ornament-extra-color", "Title color"], ["ornament-border", "Border width"], ["ornament-hpadding", "Horizontal padding"], ["ornament-vpadding", "Vertical padding"]], "parameters_by_arity": {"1": [["ornament-shape", "Shape"], ["ornament-color", "Color"], ["ornament-border", "Border width"], ["ornament-hpadding", "Horizontal padding"], ["ornament-vpadding", "Vertical padding"]]}},
    {"tags": ["manila-paper", "rough-paper", "ridged-paper", "pine", "granite", "metal"], "parameters": [["ornament-shape", "Shape"], ["ornament-border", "Border width"], ["ornament-hpadding", "Horizontal padding"], ["ornament-vpadding", "Vertical padding"]]},
    {"tags": ["embold"], "parameters": [["embold-strength", "Strength"]]},
    {"tags": ["embbb"], "parameters": [["embbb-strength", "Strength"]]},
    {"tags": ["slanted"], "parameters": [["slanted-slope", "Slope"]]},
    {"tags": ["hmagnified"], "parameters": [["hmagnified-factor", "Factor"]]},
    {"tags": ["vmagnified"], "parameters": [["vmagnified-factor", "Factor"]]},
    {"tags": ["condensed"], "parameters": [["condensed-factor", "Factor"]]},
    {"tags": ["extended"], "parameters": [["extended-factor", "Factor"]]},
    {"tags": ["monospaced"], "parameters": [["monospaced-factor", "Factor"]]},
    {"tags": ["degraded"], "parameters": [["degraded-threshold", "Threshold"], ["degraded-frequency", "Frequency"]]},
    {"tags": ["distorted"], "parameters": [["distorted-strength", "Strength"], ["distorted-frequency", "Frequency"]]},
    {"tags": ["gnawed"], "parameters": [["gnawed-strength", "Strength"], ["gnawed-frequency", "Frequency"]]},
    {"tags": ["blur", "gaussian-blur", "oval-blur", "rectangular-blur"], "parameters": [["blur-pen-width", "Pen width"], ["blur-pen-height", "Pen height"], ["blur-pen-angle", "Pen angle"]]},
    {"tags": ["motion-blur"], "parameters": [["blur-pen-dx", "Pen dx"], ["blur-pen-dy", "Pen dy"]]},
    {"tags": ["outline", "gaussian-outline", "oval-outline", "rectangular-outline"], "parameters": [["outline-pen-width", "Pen width"], ["outline-pen-height", "Pen height"], ["outline-pen-angle", "Pen angle"]]},
    {"tags": ["motion-outline"], "parameters": [["outline-pen-dx", "Pen dx"], ["outline-pen-dy", "Pen dy"]]},
    {"tags": ["thicken", "gaussian-thicken", "oval-thicken", "rectangular-thicken"], "parameters": [["thicken-pen-width", "Pen width"], ["thicken-pen-height", "Pen height"], ["thicken-pen-angle", "Pen angle"]]},
    {"tags": ["motion-thicken"], "parameters": [["thicken-pen-dx", "Pen dx"], ["thicken-pen-dy", "Pen dy"]]},
    {"tags": ["erode", "gaussian-erode", "oval-erode", "rectangular-erode"], "parameters": [["erode-pen-width", "Pen width"], ["erode-pen-height", "Pen height"], ["erode-pen-angle", "Pen angle"]]},
    {"tags": ["motion-erode"], "parameters": [["erode-pen-dx", "Pen dx"], ["erode-pen-dy", "Pen dy"]]},
    {"tags": ["shadow", "shadowed-raise"], "parameters": [["shadow-dx", "Dx"], ["shadow-dy", "Dy"], ["shadow-color", "Color"], ["shadow-blur-radius", "Blur radius"]]},
    {"tags": ["engrave"], "parameters": [["engrave-dx", "Dx"], ["engrave-dy", "Dy"], ["engrave-color", "Color"]]},
    {"tags": ["emboss"], "parameters": [["emboss-dx", "Dx"], ["emboss-dy", "Dy"], ["emboss-color", "Color"]]},
    {"tags": ["outlined-engrave"], "parameters": [["engrave-dx", "Dx"], ["engrave-dy", "Dy"], ["outline-pen-width", "Pen width"], ["outline-pen-height", "Pen height"], ["outline-pen-angle", "Pen angle"]]},
    {"tags": ["outlined-emboss"], "parameters": [["emboss-dx", "Dx"], ["emboss-dy", "Dy"], ["outline-pen-width", "Pen width"], ["outline-pen-height", "Pen height"], ["outline-pen-angle", "Pen angle"]]},
    {"tags": ["degrade"], "parameters": [["degrade-wavelen-x", "Wave length x"], ["degrade-wavelen-y", "Wave length y"], ["degrade-threshold", "Threshold"], ["degrade-sharpness", "Sharpness"]]},
    {"tags": ["distort"], "parameters": [["distort-wavelen-x", "Wave length x"], ["distort-wavelen-y", "Wave length y"], ["distort-radius-x", "Radius x"], ["distort-radius-y", "Radius y"]]},
    {"tags": ["gnaw"], "parameters": [["gnaw-wavelen-x", "Wave length x"], ["gnaw-wavelen-y", "Wave length y"], ["gnaw-radius-x", "Radius x"], ["gnaw-radius-y", "Radius y"]]},
    {"tags": ["make-transparent"], "parameters": [["make-transparent-bg-color", "Background color"], ["make-transparent-threshold", "Threshold"]]},
    {"tags": ["make-opaque"], "parameters": [["make-opaque-bg-color", "Background color"]]},
    {"tags": ["recolor"], "parameters": [["recolor-color", "New color"]]},
    {"tags": ["skin"], "parameters": [["skin-color", "Skin color"]]}
  ],
  "choices": [
    {"names": ["itemize-levels", "enumerate-levels"], "values": ["1", "2", "3", "4"]},
    {"names": ["item-tag", "item-1", "item-2", "item-3", "item-4"], "values": ["<bullet>", "<circ>", "<minus>", "<cdot>", "*", "<rightarrow>", "<Rightarrow>", "<triangleright>", "<blacktriangleright>"], "other": true},
    {"names": ["enum-tag", "enum-1", "enum-2", "enum-3", "enum-4"], "values": [
      {"label": "1, 2, 3, ...", "tree": ["macro", "x", ["arg", "x"]]},
      {"label": "a, b, c, ...", "tree": ["macro", "x", ["number", ["arg", "x"], "alpha"]]},
      {"label": "A, B, C, ...", "tree": ["macro", "x", ["number", ["arg", "x"], "Alpha"]]},
      {"label": "i, ii, iii, ...", "tree": ["macro", "x", ["number", ["arg", "x"], "roman"]]},
      {"label": "I, II, III, ...", "tree": ["macro", "x", ["number", ["arg", "x"], "Roman"]]}
    ], "other": true},
    {"names": ["padding-above", "padding-below"], "values": ["0fn", "0.5fn", "1fn", "1.5fn", "2fn"], "other": true},
    {"names": ["overlined-sep", "underlined-sep", "leftlined-sep", "rightlined-sep"], "values": ["0sep", "0.5sep", "1sep", "1.5sep", "2sep"], "other": true},
    {"names": ["ornament-hpadding", "ornament-vpadding"], "values": ["0spc", "0.5spc", "1spc", "1.5spc", "2spc"], "other": true},
    {"names": ["ornament-border"], "values": ["0ln", "0.5ln", "1ln", "2ln", "3ln", "4ln", "5ln"], "other": true},
    {"names": ["ornament-shape"], "values": ["classic", "rounded", "angular", "cartoon"]},
    {"names": ["ornament-title-style"], "values": ["classic", "top left", "top center", "top right", "bottom left", "bottom center", "bottom right"]},
    {"names": ["embold-strength", "embbb-strength"], "values": ["1.5", "2", "2.5", "3", "4", "5"], "other": true},
    {"names": ["slanted-slope"], "values": ["-1", "-0.5", "-0.33", "-0.25", "-0.2", "-0.15", "-0.1", "0.1", "0.15", "0.2", "0.25", "0.33", "0.5", "1"], "other": true},
    {"suffixes": ["magnified-factor"], "values": ["0.2", "0.5", "0.8", "0.9", "1.1", "1.2", "1.5", "2", "5"], "other": true},
    {"names": ["condensed-factor"], "values": ["0.5", "0.75", "0.8", "0.85", "0.9", "0.95"], "other": true},
    {"names": ["extended-factor"], "values": ["1.05", "1.1", "1.15", "1.2", "1.25", "1.5", "2"], "other": true},
    {"names": ["monospaced-factor"], "values": ["0.6", "0.65", "0.7", "0.75", "0.8", "0.85", "0.9", "0.95", "1"], "other": true},
    {"names": ["degraded-threshold", "degrade-threshold"], "values": ["0.5", "0.6", "0.667", "0.75"], "other": true},
    {"suffixes": ["-frequency"], "names": ["degrade-sharpness"], "values": ["0.5", "0.75", "1.0", "1.5", "2.0"], "other": true},
    {"names": ["distorted-strength", "gnawed-strength"], "values": ["0.4", "0.5", "0.6", "0.8", "1.0", "1.5"], "other": true},
    {"suffixes": ["-pen-width", "-pen-height", "-pen-dx", "-pen-dy", "-blur-radius"], "values": ["0.25ln", "0.5ln", "1ln", "1.5ln", "2ln", "2.5ln", "5ln"], "other": true},
    {"suffixes": ["-pen-angle"], "values": ["-60", "-45", "-30", "0", "30", "45", "60", "90"], "other": true},
    {"names": ["shadow-dx", "shadow-dy", "engrave-dx", "engrave-dy", "emboss-dx", "emboss-dy"], "values": ["-2.5ln", "-2ln", "-1.5ln", "-1ln", "-0.5ln", "0ln", "0.5ln", "1ln", "1.5ln", "2ln", "2.5ln"], "other": true},
    {"suffixes": ["-wavelen-x", "-wavelen-y"], "values": ["0.1fn", "0.15fn", "0.2fn", "0.25fn", "0.3fn", "0.4fn", "0.5fn"], "other": true},
    {"names": ["distort-radius-x", "distort-radius-y", "gnaw-radius-x", "gnaw-radius-y"], "values": ["0.05fn", "0.1fn", "0.15fn", "0.2fn"], "other": true}
  ],
  "pen_effects": {"blur": "gaussian", "outline": "oval", "thicken": "rectangular", "erode": "rectangular"},
  "pens": ["gaussian", "oval", "rectangular", "motion"]
}
