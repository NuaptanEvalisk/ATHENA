{
  "version": 2,
  "string_encoding": "utf-8",
  "groups": [
    {
      "mode": "in-text?",
      "bindings": [
        {"key": "\"", "commands": [{"call": "insert-quote", "args": []}]},
        {"key": "\" var", "text": "\""},
        {"key": "- var", "commands": [{"call": "make", "args": [{"symbol": "nbhyph"}]}]},
        {"key": "<", "text": "<"},
        {"key": ">", "text": ">"},
        {"key": "< var", "text": "‹"},
        {"key": "> var", "text": "›"},
        {"key": "`", "text": "‘"},
        {"key": "'", "commands": [{"call": "insert-apostrophe", "args": [false]}]},
        {"key": "` var", "text": "`"},
        {"key": "' var", "commands": [{"call": "insert-apostrophe", "args": [true]}]},
        {"key": "< <", "text": "«"},
        {"key": "< < var", "text": "<<"},
        {"key": "> >", "text": "»"},
        {"key": "> > var", "text": ">>"},
        {"key": "' '", "text": "”"},
        {"key": "' ' var", "text": "''"},
        {"key": "` `", "text": "“"},
        {"key": "` ` var", "text": "``"},
        {"key": ", ,", "text": "„"},
        {"key": ", , var", "text": ",,"},
        {"key": "- -", "text": "–"},
        {"key": "- - var", "text": "--"},
        {"key": "- - var var", "commands": [{"call": "make", "args": [{"symbol": "strike-through"}]}]},
        {"key": "- - -", "text": "—"},
        {"key": "- - - var", "text": "---"},
        {"key": "- - - -", "commands": [{"call": "make", "args": [{"symbol": "hrule"}]}]},
        {"key": "- - - - var", "text": "----"},
        {"key": "- - - - -", "text": "-----"},
        {"key": ". .", "text": ".."},
        {"key": ". . var", "commands": [{"call": "make", "args": [{"symbol": "fill-out"}]}]},
        {"key": ". . var var", "commands": [{"call": "make", "args": [{"symbol": "fill-out*"}]}]},
        {"key": ". . .", "commands": [{"call": "make", "args": [{"symbol": "text-dots"}]}]},
        {"key": ". . . var", "text": "..."},
        {"key": ". . . .", "commands": [{"call": "make", "args": [{"symbol": "fill-dots"}]}]},
        {"key": ". . . . var", "text": "...."},
        {"key": ". . . . .", "text": "....."},
        {"key": "_ _", "text": "__"},
        {"key": "_ _ var", "commands": [{"call": "make", "args": [{"symbol": "underline"}]}]},
        {"key": "/ /", "text": "//"},
        {"key": "/ / var", "commands": [{"call": "make", "args": [{"symbol": "deleted"}]}]},
        {"key": "# # var", "commands": [{"call": "make", "args": [{"symbol": "section"}]}]},
        {"key": "# # # var", "commands": [{"call": "make", "args": [{"symbol": "subsection"}]}]},
        {"key": "# # # # var", "commands": [{"call": "make", "args": [{"symbol": "subsubsection"}]}]},
        {"key": "` ` ` var", "commands": [{"call": "make", "args": [{"symbol": "verbatim-code"}]}]},
        {"key": "* * var", "commands": [{"call": "make-with", "args": ["font-series", "bold"]}]},
        {"key": "* var", "commands": [{"call": "make-with", "args": ["font-shape", "italic"]}]},
        {"key": "+ var", "commands": [{"call": "make-tmlist", "args": [{"symbol": "itemize"}]}]},
        {"key": "1 . var", "commands": [{"call": "make-tmlist", "args": [{"symbol": "enumerate"}]}]},
        {"key": "space var", "commands": [{"call": "make", "args": [{"symbol": "nbsp"}]}]},
        {"key": "space var var", "commands": [{"call": "make-space", "args": ["1em"]}]},
        {"key": "_", "text": "_"},
        {"key": "_ var", "commands": [{"call": "make-script", "args": [false, true]}]},
        {"key": "^", "text": "^"},
        {"key": "^ var", "commands": [{"call": "make-script", "args": [true, true]}]},
        {"key": "accent:deadhat var", "commands": [{"call": "make-script", "args": [true, true]}]},
        {"key": "text:symbol m", "commands": [{"call": "make", "args": [{"symbol": "masculine"}]}]},
        {"key": "text:symbol M", "commands": [{"call": "make", "args": [{"symbol": "varmasculine"}]}]},
        {"key": "text:symbol f", "commands": [{"call": "make", "args": [{"symbol": "ordfeminine"}]}]},
        {"key": "text:symbol F", "commands": [{"call": "make", "args": [{"symbol": "varordfeminine"}]}]},
        {"key": "exclamdown", "text": "¡"},
        {"key": "cent", "text": "¢"},
        {"key": "sterling", "text": "£"},
        {"key": "currency", "text": "¤"},
        {"key": "yen", "text": "¥"},
        {"key": "section", "text": "§"},
        {"key": "copyright", "text": "©"},
        {"key": "copyright var", "commands": [{"call": "make", "args": [{"symbol": "copyleft"}]}]},
        {"key": "ordfeminine", "text": "ª"},
        {"key": "ordfeminine var", "commands": [{"call": "make", "args": [{"symbol": "varordfeminine"}]}]},
        {"key": "guillemotleft", "text": "«"},
        {"key": "registered", "text": "®"},
        {"key": "circledR", "text": "®"},
        {"key": "degree", "text": "°"},
        {"key": "twosuperior", "text": "²"},
        {"key": "threesuperior", "text": "³"},
        {"key": "paragraph", "text": "¶"},
        {"key": "onesuperior", "text": "¹"},
        {"key": "masculine", "text": "º"},
        {"key": "masculine var", "commands": [{"call": "make", "args": [{"symbol": "varmasculine"}]}]},
        {"key": "guillemotright", "text": "»"},
        {"key": "onequarter", "text": "¼"},
        {"key": "onehalf", "text": "½"},
        {"key": "threequarters", "text": "¾"},
        {"key": "questiondown", "text": "¿"},
        {"key": "trademark", "text": "™"},
        {"key": "big-sum", "commands": [{"call": "insert", "args": [{"list": [{"symbol": "big"}, "sum"]}]}]},
        {"key": "dagger", "text": "†"},
        {"key": "sqrt", "commands": [{"call": "insert", "args": [{"list": [{"symbol": "sqrt"}, ""]}]}]},
        {"key": "big-int", "commands": [{"call": "insert", "args": [{"list": [{"symbol": "big"}, "int"]}]}]},
        {"key": "euro", "text": "€"},
        {"key": "ddagger", "text": "‡"},
        {"key": "centerdot", "text": "·"},
        {"key": "big-prod", "commands": [{"call": "insert", "args": [{"list": [{"symbol": "big"}, "prod"]}]}]},
        {"key": "varspace", "commands": [{"call": "insert", "args": [{"list": [{"symbol": "nbsp"}]}]}]}
      ]
    },
    {
      "mode": "in-text?",
      "require": {"call": "==", "args": [{"call": "get-env", "args": ["font"]}, "roman"]},
      "bindings": [
        {"key": "copyright", "commands": [{"call": "make", "args": [{"symbol": "copyright"}]}]},
        {"key": "ordfeminine", "commands": [{"call": "make", "args": [{"symbol": "ordfeminine"}]}]},
        {"key": "masculine", "commands": [{"call": "make", "args": [{"symbol": "masculine"}]}]},
        {"key": "€", "commands": [{"call": "make", "args": [{"symbol": "euro"}]}]},
        {"key": "euro", "commands": [{"call": "make", "args": [{"symbol": "euro"}]}]}
      ]
    },
    {
      "bindings": [
        {"key": "alpha", "text": "α"},
        {"key": "beta", "text": "β"},
        {"key": "gamma", "text": "γ"},
        {"key": "delta", "text": "δ"},
        {"key": "epsilon", "text": "ϵ"},
        {"key": "varepsilon", "text": "ε"},
        {"key": "zeta", "text": "ζ"},
        {"key": "eta", "text": "η"},
        {"key": "theta", "text": "θ"},
        {"key": "vartheta", "text": "ϑ"},
        {"key": "iota", "text": "ι"},
        {"key": "kappa", "text": "κ"},
        {"key": "varkappa", "text": "ϰ"},
        {"key": "lambda", "text": "λ"},
        {"key": "mu", "text": "μ"},
        {"key": "nu", "text": "ν"},
        {"key": "xi", "text": "ξ"},
        {"key": "omicron", "text": "ο"},
        {"key": "pi", "text": "π"},
        {"key": "varpi", "text": "ϖ"},
        {"key": "rho", "text": "ρ"},
        {"key": "varrho", "text": "ϱ"},
        {"key": "sigma", "text": "σ"},
        {"key": "varsigma", "text": "ς"},
        {"key": "tau", "text": "τ"},
        {"key": "upsilon", "text": "υ"},
        {"key": "phi", "text": "φ"},
        {"key": "varphi", "text": "ϕ"},
        {"key": "chi", "text": "χ"},
        {"key": "psi", "text": "ψ"},
        {"key": "omega", "text": "ω"},
        {"key": "Alpha", "text": "Α"},
        {"key": "Beta", "text": "Β"},
        {"key": "Gamma", "text": "Γ"},
        {"key": "Delta", "text": "Δ"},
        {"key": "Epsilon", "text": "Ε"},
        {"key": "Zeta", "text": "Ζ"},
        {"key": "Eta", "text": "Η"},
        {"key": "Theta", "text": "Θ"},
        {"key": "Iota", "text": "Ι"},
        {"key": "Kappa", "text": "Κ"},
        {"key": "Lambda", "text": "Λ"},
        {"key": "Mu", "text": "Μ"},
        {"key": "Nu", "text": "Ν"},
        {"key": "Xi", "text": "Ξ"},
        {"key": "Omicron", "text": "Ο"},
        {"key": "Pi", "text": "Π"},
        {"key": "Rho", "text": "Ρ"},
        {"key": "Sigma", "text": "Σ"},
        {"key": "Tau", "text": "Τ"},
        {"key": "Upsilon", "text": "Υ"},
        {"key": "Phi", "text": "Φ"},
        {"key": "Chi", "text": "Χ"},
        {"key": "Psi", "text": "Ψ"},
        {"key": "Omega", "text": "Ω"}
      ]
    },
    {
      "mode": "in-variants-disabled?",
      "bindings": [
        {"key": "- var", "commands": [{"call": "insert", "args": ["-"]}, {"call": "kbd-tab", "args": []}]},
        {"key": "space var", "commands": [{"call": "insert", "args": [" "]}, {"call": "kbd-tab", "args": []}]},
        {"key": "space var var", "commands": [{"call": "insert", "args": [" "]}, {"call": "kbd-tab", "args": []}, {"call": "kbd-tab", "args": []}]}
      ]
    },
    {
      "mode": "in-verbatim?",
      "bindings": [
        {"key": "space var", "commands": [{"call": "insert-tabstop", "args": []}]},
        {"key": "space var var", "commands": [{"call": "insert-tabstop", "args": []}, {"call": "insert-tabstop", "args": []}]},
        {"key": "$", "commands": [{"call": "insert", "args": ["$"]}]},
        {"key": "$ var", "commands": [{"call": "make", "args": [{"symbol": "math"}]}]},
        {"key": "\\", "text": "\\"},
        {"key": "\\ var", "commands": [{"call": "make", "args": [{"symbol": "hybrid"}]}]},
        {"key": "\"", "text": "\""},
        {"key": "`", "text": "`"},
        {"key": "` var", "text": "‘"},
        {"key": "'", "text": "'"},
        {"key": "' var", "text": "’"},
        {"key": "< <", "text": "<<"},
        {"key": "> >", "text": ">>"},
        {"key": "' '", "text": "''"},
        {"key": "` `", "text": "``"},
        {"key": "- -", "text": "--"},
        {"key": "- - -", "text": "---"},
        {"key": "< < var", "text": "«"},
        {"key": "> > var", "text": "»"},
        {"key": "' ' var", "text": "”"},
        {"key": "` ` var", "text": "“"},
        {"key": ", , var", "text": "„"},
        {"key": "- - var", "text": "–"},
        {"key": "- - - var", "text": "—"}
      ]
    },
    {
      "mode": "in-text?",
      "bindings": [
        {"key": "font ^", "commands": [{"call": "make-script", "args": [true, true]}]},
        {"key": "font hat", "commands": [{"call": "make-script", "args": [true, true]}]},
        {"key": "font _", "commands": [{"call": "make-script", "args": [false, true]}]},
        {"key": "font s", "commands": [{"call": "make-with", "args": ["font-family", "ss"]}]},
        {"key": "font t", "commands": [{"call": "make-with", "args": ["font-family", "tt"]}]},
        {"key": "font b", "commands": [{"call": "make-with", "args": ["font-series", "bold"]}]},
        {"key": "font m", "commands": [{"call": "make-with", "args": ["font-series", "medium"]}]},
        {"key": "font r", "commands": [{"call": "make-with", "args": ["font-shape", "right"]}]},
        {"key": "font i", "commands": [{"call": "make-with", "args": ["font-shape", "italic"]}]},
        {"key": "font l", "commands": [{"call": "make-with", "args": ["font-shape", "slanted"]}]},
        {"key": "font o", "commands": [{"call": "make", "args": [{"symbol": "overline"}]}]},
        {"key": "font p", "commands": [{"call": "make-with", "args": ["font-shape", "small-caps"]}]},
        {"key": "font u", "commands": [{"call": "make", "args": [{"symbol": "underline"}]}]}
      ]
    },
    {
      "profiles": ["macos"],
      "mode": "in-text?",
      "bindings": [
        {"key": "macos {", "commands": [{"call": "make-line-with", "args": ["par-mode", "left"]}]},
        {"key": "macos |", "commands": [{"call": "make-line-with", "args": ["par-mode", "center"]}]},
        {"key": "macos }", "commands": [{"call": "make-line-with", "args": ["par-mode", "right"]}]},
        {"key": "macos C-{", "commands": [{"call": "make-line-with", "args": ["par-mode", "justify"]}]}
      ]
    },
    {
      "profiles": ["windows"],
      "mode": "in-text?",
      "bindings": [
        {"key": "windows 1", "commands": [{"call": "make-line-with", "args": ["par-line-sep", "0fn"]}]},
        {"key": "windows 2", "commands": [{"call": "make-line-with", "args": ["par-line-sep", "1fn"]}]},
        {"key": "windows 5", "commands": [{"call": "make-line-with", "args": ["par-line-sep", "0.5fn"]}]},
        {"key": "windows l", "commands": [{"call": "make-line-with", "args": ["par-mode", "left"]}]},
        {"key": "windows e", "commands": [{"call": "make-line-with", "args": ["par-mode", "center"]}]},
        {"key": "windows r", "commands": [{"call": "make-line-with", "args": ["par-mode", "right"]}]},
        {"key": "windows j", "commands": [{"call": "make-line-with", "args": ["par-mode", "justify"]}]},
        {"key": "windows t", "commands": [{"call": "make", "args": [{"symbol": "indent"}]}]}
      ]
    },
    {
      "mode": "in-std-text?",
      "bindings": [
        {"key": "text $", "commands": [{"call": "make-equation*", "args": []}]},
        {"key": "text &", "commands": [{"call": "make-eqnarray*", "args": []}]},
        {"key": "text a", "commands": [{"call": "make", "args": [{"symbol": "abbr"}]}]},
        {"key": "text d", "commands": [{"call": "make-tmlist", "args": [{"symbol": "description"}]}]},
        {"key": "text e", "commands": [{"call": "make-tmlist", "args": [{"symbol": "enumerate"}]}]},
        {"key": "text i", "commands": [{"call": "make-tmlist", "args": [{"symbol": "itemize"}]}]},
        {"key": "text m", "commands": [{"call": "make", "args": [{"symbol": "em"}]}]},
        {"key": "text n", "commands": [{"call": "make", "args": [{"symbol": "name"}]}]},
        {"key": "text p", "commands": [{"call": "make", "args": [{"symbol": "samp"}]}]},
        {"key": "text s", "commands": [{"call": "make", "args": [{"symbol": "strong"}]}]},
        {"key": "text v", "commands": [{"call": "make", "args": [{"symbol": "verbatim"}]}]},
        {"key": "text ;", "commands": [{"call": "make-item", "args": []}]},
        {"key": "text 0", "commands": [{"call": "make-section", "args": [{"symbol": "chapter"}]}]},
        {"key": "text 1", "commands": [{"call": "make-section", "args": [{"symbol": "section"}]}]},
        {"key": "text 2", "commands": [{"call": "make-section", "args": [{"symbol": "subsection"}]}]},
        {"key": "text 3", "commands": [{"call": "make-section", "args": [{"symbol": "subsubsection"}]}]},
        {"key": "text 4", "commands": [{"call": "make-section", "args": [{"symbol": "paragraph"}]}]},
        {"key": "text 5", "commands": [{"call": "make-section", "args": [{"symbol": "subparagraph"}]}]},
        {"key": "F5", "commands": [{"call": "make", "args": [{"symbol": "em"}]}]},
        {"key": "F6", "commands": [{"call": "make", "args": [{"symbol": "strong"}]}]},
        {"key": "F7", "commands": [{"call": "make", "args": [{"symbol": "verbatim"}]}]},
        {"key": "F8", "commands": [{"call": "make", "args": [{"symbol": "samp"}]}]},
        {"key": "S-F6", "commands": [{"call": "make", "args": [{"symbol": "name"}]}]}
      ]
    },
    {
      "mode": "in-std?",
      "bindings": [
        {"key": "std @", "commands": [{"call": "go-to-section-title", "args": []}]}
      ]
    }
  ]
}
