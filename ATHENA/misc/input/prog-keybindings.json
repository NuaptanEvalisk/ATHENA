{
  "version": 2,
  "string_encoding": "utf-8",
  "groups": [
    {
      "mode": "in-prog?",
      "bindings": [
        {"key": "tab", "commands": [{"call": "insert-tabstop", "args": []}]},
        {"key": "S-tab", "commands": [{"call": "remove-tabstop", "args": []}]},
        {"key": "A-tab", "commands": [{"call": "insert-tabstop", "args": []}]},
        {"key": "structured:cmd space", "commands": [{"call": "program-select-enlarge", "args": []}]},
        {"key": "C->", "commands": [{"call": "program-select-enlarge", "args": []}]},
        {"key": "C-.", "commands": [{"call": "program-select-enlarge", "args": []}]},
        {"key": "cmd i", "commands": [{"call": "program-indent", "args": [false]}]},
        {"key": "cmd I", "commands": [{"call": "program-indent", "args": [true]}]},
        {"key": "cmd tab", "commands": [{"call": "program-indent", "args": [false]}]},
        {"key": "cmd S-tab", "commands": [{"call": "program-indent", "args": [true]}]},
        {"key": "cmd A-tab", "commands": [{"call": "program-indent-all", "args": [false]}]},
        {"key": "space var", "commands": [{"call": "insert-tabstop", "args": []}]},
        {"key": "space var var", "commands": [{"call": "insert-tabstop", "args": []},{"call": "insert-tabstop", "args": []}]},
        {"key": "$", "commands": [{"call": "insert", "args": ["$"]}]},
        {"key": "$ var", "commands": [{"call": "make", "args": [{"symbol": "math"}]}]},
        {"key": "\\", "text": "\\"},
        {"key": "\\ var", "commands": [{"call": "make", "args": [{"symbol": "hybrid"}]}]},
        {"key": "`", "text": "`"},
        {"key": "` var", "text": "‘"},
        {"key": "' var", "text": "’"},
        {"key": "< <", "text": "<<"},
        {"key": "> >", "text": ">>"},
        {"key": "' '", "text": "''"},
        {"key": "` `", "text": "``"},
        {"key": "- -", "text": "--"},
        {"key": "- - -", "text": "---"},
        {"key": "< < var", "text": "«"},
        {"key": "> > var", "text": "»"},
        {"key": "' ' var", "text": "”"},
        {"key": "` ` var", "text": "“"},
        {"key": ", , var", "text": "„"},
        {"key": "- - var", "text": "–"},
        {"key": "- - - var", "text": "—"},
        {"key": "(", "commands": [{"call": "program-bracket", "args": ["(", ")",false]}]},
        {"key": ")", "commands": [{"call": "program-bracket", "args": ["(", ")",true]}]},
        {"key": "[", "commands": [{"call": "program-bracket", "args": ["[", "]",false]}]},
        {"key": "]", "commands": [{"call": "program-bracket", "args": ["[", "]",true]}]},
        {"key": "{", "commands": [{"call": "program-bracket", "args": ["{", "}",false]}]},
        {"key": "}", "commands": [{"call": "program-bracket", "args": ["{", "}",true]}]},
        {"key": "\"", "commands": [{"call": "program-bracket", "args": ["\"", "\"",false]}]},
        {"key": "'", "commands": [{"call": "program-bracket", "args": ["'", "'",false]}]}
      ]
    }
  ]
}
