# Target policy, not build-host detection. Keep iPadOS separate from macOS.
set (ATHENA_PLATFORM_IPADOS OFF)
set (ATHENA_PLATFORM_MACOS OFF)
if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
  set (ATHENA_PLATFORM_IPADOS ON)
elseif (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  set (ATHENA_PLATFORM_MACOS ON)
endif ()

set (ATHENA_ENABLE_CLI ON)
set (ATHENA_ENABLE_GUILE_JIT ON)
set (ATHENA_ENABLE_RUNTIME_SCHEME_REFRESH ON)
set (ATHENA_ENABLE_CODEX_BRIDGE ON)
set (ATHENA_ENABLE_AUDMAP_REPL ON)
set (ATHENA_ENABLE_AUDMAP_LISTENER ON)
set (ATHENA_ENABLE_PLUGINS ON)
set (ATHENA_ENABLE_FORMULA_CLEANER ON)
set (ATHENA_ENABLE_WEBSITE_EXPORT ON)
set (ATHENA_ENABLE_WATCHDOG OFF)
if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set (ATHENA_ENABLE_WATCHDOG ON)
endif ()

if (ATHENA_PLATFORM_IPADOS)
  set (ATHENA_ENABLE_CLI OFF)
  set (ATHENA_ENABLE_GUILE_JIT OFF)
  set (ATHENA_ENABLE_RUNTIME_SCHEME_REFRESH OFF)
  set (ATHENA_ENABLE_CODEX_BRIDGE OFF)
  set (ATHENA_ENABLE_AUDMAP_REPL OFF)
  # Keep the protocol/resource libraries; no local listener or plugin launch.
  set (ATHENA_ENABLE_AUDMAP_LISTENER OFF)
  set (ATHENA_ENABLE_PLUGINS OFF)
  set (ATHENA_ENABLE_FORMULA_CLEANER OFF)
  set (ATHENA_ENABLE_WEBSITE_EXPORT OFF)
  if (CMAKE_OSX_DEPLOYMENT_TARGET AND
      CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "27.0")
    message (FATAL_ERROR "ATHENA for iPadOS requires deployment target 27.0 or later")
  endif ()
  set (ATHENA_CPU_TARGET_DEFAULT "arm64")
else ()
  set (ATHENA_CPU_TARGET_DEFAULT "native")
endif ()

set (ATHENA_CPU_TARGET "${ATHENA_CPU_TARGET_DEFAULT}" CACHE STRING
  "CPU ISA target: native, arm64, x86-64-v3, x86-64-v2, or x86-64")
set_property (CACHE ATHENA_CPU_TARGET PROPERTY STRINGS
  native arm64 x86-64-v3 x86-64-v2 x86-64)
if (ATHENA_PLATFORM_IPADOS AND NOT ATHENA_CPU_TARGET STREQUAL "arm64")
  message (FATAL_ERROR "Use a separate iPadOS build tree with ATHENA_CPU_TARGET=arm64")
endif ()
if (ATHENA_CPU_TARGET STREQUAL "arm64")
  # The Apple toolchain selects arm64. M2+ is the supported device baseline,
  # not a reason to leak host-native or AVX instructions into dependencies.
  set (ATHENA_CPU_COMPILE_FLAGS "")
elseif (ATHENA_CPU_TARGET STREQUAL "native")
  set (ATHENA_CPU_COMPILE_FLAGS "-march=native")
  if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    string (APPEND ATHENA_CPU_COMPILE_FLAGS " -mavx2")
  endif ()
elseif (ATHENA_CPU_TARGET MATCHES "^x86-64(-v[23])?$")
  set (ATHENA_CPU_COMPILE_FLAGS "-march=${ATHENA_CPU_TARGET} -mtune=generic")
else ()
  message (FATAL_ERROR "Unsupported ATHENA_CPU_TARGET='${ATHENA_CPU_TARGET}'")
endif ()
message (STATUS "ATHENA CPU target: ${ATHENA_CPU_TARGET} (${ATHENA_CPU_COMPILE_FLAGS})")
