set(ATHENA_COMMANDS_SOURCE_DIR "${ATHENA_SOURCE_DIR}/src/ATHENA/Commands/Interfaces")
set(ATHENA_COMMANDS_OUTPUT_DIR "${ATHENA_BINARY_DIR}/generated/athena-commands")
set(ATHENA_COMMANDS_INPUTS)
set(ATHENA_COMMANDS_OUTPUTS)
foreach(group basic editor server native)
  list(APPEND ATHENA_COMMANDS_INPUTS "${ATHENA_COMMANDS_SOURCE_DIR}/${group}.xml")
  list(APPEND ATHENA_COMMANDS_OUTPUTS
    "${ATHENA_COMMANDS_OUTPUT_DIR}/commands_${group}.cpp")
endforeach()

set(ATHENA_COMMANDS_COMMAND
  "${Python3_EXECUTABLE}" "${ATHENA_COMMANDS_SOURCE_DIR}/generate-commands.py"
  --output-dir "${ATHENA_COMMANDS_OUTPUT_DIR}" ${ATHENA_COMMANDS_INPUTS})
execute_process(COMMAND ${ATHENA_COMMANDS_COMMAND}
  RESULT_VARIABLE ATHENA_COMMANDS_RESULT ERROR_VARIABLE ATHENA_COMMANDS_ERROR)
if(NOT ATHENA_COMMANDS_RESULT EQUAL 0)
  message(FATAL_ERROR "ATHENA command generation failed: ${ATHENA_COMMANDS_ERROR}")
endif()
add_custom_command(
  OUTPUT ${ATHENA_COMMANDS_OUTPUTS}
  COMMAND ${ATHENA_COMMANDS_COMMAND}
  COMMAND "${CMAKE_COMMAND}" -E touch ${ATHENA_COMMANDS_OUTPUTS}
  DEPENDS ${ATHENA_COMMANDS_INPUTS}
          "${ATHENA_COMMANDS_SOURCE_DIR}/generate-commands.py"
  COMMENT "Generating C++ bindings from ATHENA XML interfaces"
  VERBATIM)
add_custom_target(athena_commands DEPENDS ${ATHENA_COMMANDS_OUTPUTS})
set_property(TARGET athena_commands PROPERTY ATHENA_COMMANDS_INTERFACES "${ATHENA_COMMANDS_INPUTS}")
