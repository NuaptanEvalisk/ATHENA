#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: build-glue <output-directory>" >&2
  exit 2
fi
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "${PYTHON:-python3}" "$source_dir/generate-glue.py" \
  --output-dir "$1" \
  "$source_dir/basic.xml" "$source_dir/editor.xml" "$source_dir/server.xml" \
  "$source_dir/native.xml"
