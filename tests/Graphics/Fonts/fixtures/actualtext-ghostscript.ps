%!PS-Adobe-3.0
%%Title: Isolated ActualText geometry regression
%%Creator: ATHENA regression fixture (C) 2026 Nuaptan Felix Evalisk
%%Copyright: GNU GPL version 3 or later; see LICENSE in the repository root.
%%Pages: 1
%%EndComments
% gs -q -dSAFER -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -o sample.pdf this-file.ps
% pdftotext -bbox sample.pdf -
% Both rows should have text bounds near x=48..106 and nonzero height.
% With Ghostscript 10.07.1, the ActualText row gets zero-height bounds and
% incorrect coordinates in Poppler; the plain row retains valid geometry.
<< /PageSize [595 842] >> setpagedevice
/Helvetica findfont 12 scalefont setfont
48 770 moveto
[ /Span << /ActualText <FEFF00680065006C006C006F0020> >> /BDC pdfmark
(hello ) show
[ /EMC pdfmark
[ /Span << /ActualText <FEFF0077006F0072006C0064> >> /BDC pdfmark
(world) show
[ /EMC pdfmark
48 734 moveto (hello world) show
showpage
%%EOF
