;; Exercise the real audit script with a deterministic nonblocking dispatcher.
(define scenario (getenv "ATHENA_AUDIT_DISPATCH_SCENARIO"))
(define pending '())
(define finished? #f)
(define submissions 0)
(define passes 0)
(define (string->url value) value)
(define (set-preference . args) #t)
(define (vault-load-with-ns . args) "")
(define (buffer-load . args) #f)
(define (switch-to-buffer . args) #t)
(define (data-art-source-version) 3)
(define (update-current-buffer) (set! passes (+ passes 1)))
(define (update-forced) #t)
(define (get-debug-messages . args) '())
(define (tree-children value) value)
(define (quit-TeXmacs) (set! finished? #t))
(define (exec-global thunk) (set! pending (append pending (list thunk))))
(define (exec-buffer source thunk)
  (set! submissions (+ submissions 1))
  (if (or (equal? scenario "closed")
          (and (equal? scenario "busy") (not (memv submissions '(4 8)))))
      #f
      (begin (exec-global thunk) #t)))

(primitive-load (getenv "ATHENA_AUDIT_DISPATCH_SCRIPT"))
(let loop ((turns 0))
  (unless (or finished? (null? pending))
    (when (> turns 250) (error "Audit dispatcher did not terminate"))
    (let ((thunk (car pending)))
      (set! pending (cdr pending))
      (thunk))
    (loop (+ turns 1))))
(unless finished? (error "Audit lost its completion callback"))
(let ((result (call-with-input-file (getenv "ATHENA_LOAD_AUDIT_RESULT") read)))
  (if (equal? scenario "closed")
      (unless (and (= submissions 100) (= passes 0)
                   (equal? result '(could-not-enter-buffer-actor)))
        (error "Unbounded retry or swallowed submission failure" submissions passes result))
      (unless (and (= passes 2) (eq? result #t)
                   (= submissions (if (equal? scenario "busy") 8 2)))
        (error "Audit skipped or duplicated a typesetting pass" submissions passes result))))
