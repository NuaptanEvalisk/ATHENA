;; Run without a build: guile --no-auto-compile -s this-file REPO
;; Evaluate the shipped Scheme dispatch with deterministic native-boundary
;; doubles. Native conversion/rendering remains the centralized runtime suite.
(use-modules (srfi srfi-1) (srfi srfi-8))
(define root (cadr (command-line)))
(define (check value message) (unless value (error message)))
(define == equal?)
(define (!= a b) (not (equal? a b)))
(define list-any any)
(define-syntax-rule (with name value body ...) (let ((name value)) body ...))
(define (func? x tag . arity)
  (and (pair? x) (eq? (car x) tag)
       (or (null? arity) (= (length (cdr x)) (car arity)))))
(define (read-forms file)
  (call-with-input-file (string-append root "/" file)
    (lambda (port)
      (let loop ((result '()) (form (read port)))
        (if (eof-object? form) (reverse result)
            (loop (cons form result) (read port)))))))
(define latex (read-forms "ATHENA/progs/convert/latex/init-latex.scm"))
(define (load-definitions forms names)
  (for-each
    (lambda (form)
      (when (and (pair? form) (memq (car form) '(define tm-define))
                 (pair? (cadr form)) (memq (caadr form) names))
        (eval (cons 'define (cdr form)) (current-module))))
    forms))
(define (edge forms from to)
  (find (lambda (form)
          (and (func? form 'converter)
               (eq? (cadr form) from) (eq? (caddr form) to))) forms))
(define (invoke forms from to source opts)
  (let* ((registration (edge forms from to))
         (function (assoc-ref (cdddr registration) ':function-with-options)))
    ((module-ref (current-module) (car function)) source opts)))
(define (std-converter-options from to)
  '(("texmacs->latex:encoding" . "utf-8")))

(define tree? vector?)
(define prepared-count 0)
(define (latex-export-prepare-v3-source x)
  (set! prepared-count (+ prepared-count 1))
  (vector-ref x 0))
(define source '(math (scripts "o" "x" "" "" "i" "n")))
(define native (vector source))
(define output '(!concat "valid"))
(define seen-source #f)
(define seen-options #f)
(define (texmacs->latex x opts)
  (set! seen-source x)
  (set! seen-options opts)
  (if (procedure? output) (output) output))
(define serialize-latex identity)
(define conservative-count 0)
(define (conservative-texmacs->latex x opts)
  (set! conservative-count (+ conservative-count 1)) 'legacy-output)
(load-definitions latex
  '(latex-native-v3-math? latex-native-v3-check-output texmacs->latex-checked
    texmacs-tree->latex-stree texmacs->latex-document
    texmacs-tree->latex-document texmacs-stree->latex-document))

(for-each
  (lambda (to)
    (check (equal? (invoke latex 'texmacs-tree to native '()) output)
           "native LaTeX route changed output")
    (check (equal? seen-source source) "typed preparation missing"))
  '(latex-stree latex-document))
(check (= prepared-count 2) "native source prepared more than once")
(check (= conservative-count 0) "native source entered conservative export")
(check (equal? (invoke latex 'texmacs-stree 'latex-document source '()) output)
       "prepared stree document bypassed checked export")
(check (equal? (invoke latex 'texmacs-stree 'latex-document '(math "x") '())
               'legacy-output) "v2 conservative path changed")
(invoke latex 'texmacs-tree 'latex-stree native
        '(("texmacs->latex:encoding" . "ascii")))
(check (equal? (assoc-ref seen-options "texmacs->latex:encoding") "ascii")
       "explicit option lost to inherited defaults")

(define (expect-error thunk reason)
  (let ((caught (catch #t (lambda () (thunk) #f) (lambda args args))))
    (check (and caught (string-contains (object->string caught) reason))
           (string-append "missing explicit failure: " reason))))
(for-each
  (lambda (bad)
    (set! output bad)
    (for-each
      (lambda (route)
        (expect-error
          (lambda () (invoke latex (car route) (cadr route)
                       (if (eq? (car route) 'texmacs-tree) native source) '()))
          "XML v3"))
      '((texmacs-tree latex-document) (texmacs-tree latex-stree)
        (texmacs-stree latex-document) (texmacs-stree latex-stree))))
  '(#f (!concat (!group (nonconverted "unmapped")))
    (!concat ((nonconverted "first node in a node-set")))
    (!concat (!athena-data-inline "preserved"))))
(set! output (lambda () (throw 'native-export-error "unsupported exact reason")))
(expect-error (lambda () (texmacs-tree->latex-document native '()))
              "unsupported exact reason")
(check (= conservative-count 1) "error retried through legacy exporter")
(set! output '(!concat "valid"))

(display "PASS: native v3 LaTeX routes and fail-closed dispatch\n")
