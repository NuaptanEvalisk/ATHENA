;; Native generic document environment commands execute on the owning BufferActor.
(import-from (generic document-edit))
(init-style "generic")

(define (check condition message)
  (unless condition
    (error message (get-init-tree "page-medium")
                   (get-init-tree "page-orientation"))))

(init-env-tree "document-test-macro" '(macro "old"))
(check (equal? (get-init-env "document-test-macro") "old")
       "native macro init lookup")
(set-init-env "document-test-macro" "new")
(check (equal? (tree->stree (get-init-tree "document-test-macro"))
               '(macro "new"))
       "set-init-env preserves an existing macro wrapper")
(set-init-env "document-test-macro" '(macro "direct"))
(check (equal? (tree->stree (get-init-tree "document-test-macro"))
               '(macro "direct"))
       "set-init-env does not double-wrap macro input")

(init-env-tree "document-test-complex" '(concat "a" "b"))
(check (not (get-init-env "document-test-complex"))
       "non-atomic non-macro init has no string view")

(set-style-list '("generic" "american" "french"))
(check (not (test-default-document-language?))
       "document language style disables the default-language predicate")
(check (equal? (get-document-language) "french")
       "document language ignores american because legacy supported-languages does")
(check (test-document-language? "french")
       "document language predicate matches selected style language")
(set-default-document-language)
(check (test-default-document-language?)
       "default document language removes supported language packages")
(check (equal? (get-style-list) '("generic" "american"))
       "default document language preserves non-document language styles")
(set-document-language "german")
(check (equal? (get-document-language) "german")
       "set-document-language appends a non-English language")
(check (equal? (get-style-list) '("generic" "american" "german"))
       "document language preserves unrelated style order")
(set-document-language "english")
(check (equal? (get-style-list) '("generic" "american"))
       "English document language is represented by removing language packages")
(set-style-list '("generic"))

(init-env "page-medium" "paper")
(init-env "page-border" "attached")
(init-env "page-packet" "2")
(init-env "page-offset" "1")
(check (equal? (get-init-page-rendering) "book")
       "native page rendering detects book mode")
(check (test-page-rendering? "book")
       "native page rendering predicate")
(document-apply-page-rendering-state "book")
(check (and (equal? (get-init "page-medium") "paper")
            (equal? (get-init "page-border") "attached")
            (equal? (get-init "page-packet") "2")
            (equal? (get-init "page-offset") "1"))
       "native book rendering state")
(init-default-page-rendering)
(check (and (test-default-page-rendering?)
            (not (init-has? "page-border"))
            (not (init-has? "page-packet"))
            (not (init-has? "page-offset")))
       "native default page rendering resets all rendering variables")

(remove-style-package "reduced-margins")
(remove-style-package "normal-margins")
(init-env "page-odd" "1cm")
(check (reduced-margins?) "reduced margin predicate")
(toggle-reduced-margins)
(check (has-style-package? "normal-margins")
       "reduced-margin toggle adds normal override when reduced margins are active")
(toggle-reduced-margins)
(check (not (has-style-package? "normal-margins"))
       "reduced-margin toggle removes normal override first")
(init-env "page-odd" "2cm")
(toggle-reduced-margins)
(check (has-style-package? "reduced-margins")
       "reduced-margin toggle adds reduced package from normal margins")
(remove-style-package "reduced-margins")

(remove-style-package "indent-paragraphs")
(remove-style-package "padded-paragraphs")
(init-env "par-first" "0cm")
(check (not (indent-paragraphs?)) "zero paragraph indent predicate")
(toggle-indent-paragraphs)
(check (has-style-package? "indent-paragraphs")
       "indent toggle adds indent package from zero indent")
(toggle-indent-paragraphs)
(check (not (has-style-package? "indent-paragraphs"))
       "indent toggle removes active indent package")
(init-env "par-first" "1fn")
(check (indent-paragraphs?) "nonzero paragraph indent predicate")
(toggle-indent-paragraphs)
(check (has-style-package? "padded-paragraphs")
       "indent toggle adds padded package from nonzero indent")
(remove-style-package "padded-paragraphs")

(remove-style-package "page-numbers")
(remove-style-package "no-page-numbers")
(init-env "no-page-numbers" "true")
(check (no-page-numbers?) "no-page-numbers predicate")
(toggle-no-page-numbers)
(check (has-style-package? "page-numbers")
       "page-number toggle adds page-numbers override")
(toggle-no-page-numbers)
(check (not (has-style-package? "page-numbers"))
       "page-number toggle removes active override")
(init-env "no-page-numbers" "false")
(toggle-no-page-numbers)
(check (has-style-package? "no-page-numbers")
       "page-number toggle adds no-page-numbers package")
(remove-style-package "no-page-numbers")

(init-env "page-medium" "paper")
(init-env "page-orientation" "landscape")
(update-current-buffer)
(update-forced)
(define (legacy-panorama-packets)
  (let* ((nr (nr-pages))
         (ww (get-window-width))
         (wh (get-window-height))
         (pw (get-page-width #f))
         (ph (get-page-height #f))
         (best-n 0)
         (best-f 0))
    (for (n (.. 1 (+ nr 1)))
      (let* ((r (quotient (+ nr (- n 1)) n))
             (tw (* n pw))
             (th (* r ph))
             (aw (- ww (* n 5120)))
             (ah (- wh (* r 5120)))
             (fw (/ (* 1.0 aw) tw))
             (fh (/ (* 1.0 ah) th))
             (f (min fw fh)))
        (when (or (== n 1) (> f best-f))
          (set! best-n n)
          (set! best-f f))))
    (cond ((> best-n 0) best-n)
          ((> nr 10) 10)
          (else (inexact->exact (ceiling (sqrt (* 1.0 nr))))))))
(check (== (panorama-packets) (legacy-panorama-packets))
       "native panorama packet count matches legacy geometry policy")
(print-to-file (string->url (string-append (getenv "HOME") "/evaluation.pdf")))
#t
