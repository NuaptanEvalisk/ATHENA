;; Remaining generic editing commands preserve their Scheme behavior.
(module-provide '(generic live-spell))
(init-style "generic")

(define (body) (tree->stree (buffer-tree)))
(define (check value message)
  (unless value (error "Generic native regression" message (body) (cursor-path))))
(define (reset content cursor)
  (selection-cancel)
  (cancel-alt-selection "spell-live")
  (buffer-set-body (current-buffer-url) (stree->tree content))
  (update-current-buffer)
  ;; Clipboard copying inspects layout boxes even in a headless editor.
  (update-forced)
  (go-to-path cursor)
  (commit-changes)
  (clear-undo-history))

(reset '(document "abcdef" "next") '(0 0 2))
(yank-paragraph)
(check (equal? (body) '(document "abcdef" "next")) "yank keeps paragraph")
(check (equal? (tree->stree (selection-tree)) "cdef") "yank selects paragraph suffix")
(reset '(document "abcdef" "next") '(0 0 2))
(kill-paragraph)
(check (equal? (body) '(document "ab" "next")) "kill removes paragraph suffix only")
(check (equal? (cursor-path) '(0 0 2)) "kill cursor")
(commit-changes)
(undo 0)
(check (equal? (body) '(document "abcdef" "next")) "kill is undoable")

(reset '(document "helo world") '(0 0 2))
(set-alt-selection "spell-live" '((0 0 0) (0 0 4)))
(spell-live-replace-current-word "hello")
(check (equal? (body) '(document "hello world")) "spelling replacement")
(check (equal? (cursor-path) '(0 0 5)) "spelling replacement cursor")
(undo 0)
(check (equal? (body) '(document "helo world")) "spelling replacement undo group")
(cancel-alt-selection "spell-live")
(spell-live-replace-current-word "ignored")
(spell-live-insert-current-word)
(check (equal? (body) '(document "helo world")) "missing spelling selection is harmless")

(reset '(document "Generic native commands passed") '(0 0 0))
(init-env "page-medium" "paper")
(update-current-buffer)
(update-forced)
(print-to-file (string->url (string-append (getenv "HOME") "/evaluation.pdf")))
