;; Run without a build: guile --no-auto-compile -s this-file REPO
;; Exercise shipped registration/functions using native-boundary doubles.
(use-modules (srfi srfi-1))
(define root (cadr (command-line)))
(define (check value message) (unless value (error message)))
(define registrations '())
(define format-declaration #f)
(define-syntax-rule (texmacs-module name) #t)
(define-syntax-rule (define-format name option ...)
  (set! format-declaration '(name option ...)))
(define-syntax-rule (tm-define signature body ...) (define signature body ...))
(define-syntax-rule (converter source target (:function procedure))
  (set! registrations (acons (list 'source 'target) procedure registrations)))
(define parse-count 0)
(define native-count 0)
(define (parse-xml source)
  (set! parse-count (+ parse-count 1)) (list 'parsed source))
(define result (vector 'native-tree 'typed-metadata))
(define fail? #f)
(define (native-mathml->tree-v3 source)
  (set! native-count (+ native-count 1))
  (when fail? (throw 'misc-error "native unsupported reason"))
  result)
(define (native-mathml->tree source) (error "legacy importer must not run"))
(define (tree->stree source) (error "typed metadata must not pass through stree"))
(primitive-load (string-append root "/ATHENA/progs/convert/mathml/init-mathml.scm"))
(check (equal? format-declaration '(mathml-v3 (:name "MathML (native v3)")))
       "native format must not take over automatic recognition or suffixes")
(for-each
  (lambda (source)
    (let ((procedure (assoc-ref registrations (list source 'texmacs-tree))))
      (check (procedure? procedure) "direct native route missing")
      (check (eq? (procedure "<math/>") result) "native result was rebuilt or erased")))
  '(mathml-v3-snippet mathml-v3-document mathml-v3-stree))
(check (= parse-count 2) "parsed MathML must not be parsed twice")
(check (= native-count 3) "all routes must invoke the v3 native binding")
(set! fail? #t)
(check
  (equal? (catch 'misc-error
            (lambda () (mathml-v3->texmacs "unsupported") #f)
            (lambda args args))
          '(misc-error "native unsupported reason"))
  "native failure was swallowed or retried")
(check (= native-count 4) "failed import was retried")
(call-with-input-file (string-append root "/ATHENA/progs/init-athena.scm")
  (lambda (port)
    (let loop ((form (read port)))
      (check (not (eof-object? form)) "native MathML lazy registration missing")
      (unless (equal? form '(lazy-format (convert mathml init-mathml) mathml-v3))
        (loop (read port))))))
(display "PASS: MathML v3 registration, native-only dispatch and error propagation\n")
