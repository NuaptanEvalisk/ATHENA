;; Real load, keyboard editing, save and recovery on the owning BufferActor.
;; The driver copies every input to a private directory before launching us.
(use-modules (srfi srfi-1))
(define root (getenv "ATHENA_V3_PERSISTENCE_ROOT"))
(define phase (getenv "ATHENA_V3_PERSISTENCE_PHASE"))
(define source (string->url (string-append root "/source.ath")))
(define autosave (string->url (string-append root "/source.ath~")))
(define recovered (string->url (string-append root "/recovered.ath")))
(define marker "ATHENA v3 keyboard probe")
(define auto-marker "ATHENA v3 autosave probe")
(define (check condition label)
  (unless condition (error "Native v3 persistence regression" phase label)))
(define (contains? value text)
  (if (tree-atomic? value)
      (string-contains? (tree->string value) text)
      (any (lambda (child) (contains? child text)) (tree-children value))))
(define (has-tag? value tag)
  (and (not (tree-atomic? value))
       (or (eq? (tree-label value) tag)
           (any (lambda (child) (has-tag? child tag)) (tree-children value)))))
(define (finish value)
  (call-with-output-file (string-append root "/result-" phase ".scm")
    (lambda (port) (write value port)))
  (quit-TeXmacs))
(define (fail . args)
  (exec-global (lambda () (finish args))))
(define (append-paragraph content)
  (let* ((body (buffer-tree)) (index (tree-arity body)))
    (start-editing)
    (tree-insert body index (list (stree->tree content)))
    (commit-changes)
    (tree-ref (buffer-tree) index)))
(define (run-owned)
  (catch #t
    (lambda ()
      (check (= (data-art-source-version) 3) "loaded buffer is not native v3")
      (check (source-node-identities-active?) "source identity baseline missing")
      (cond
        ((equal? phase "edit")
         (let ((paragraph (append-paragraph "")))
           (tree-go-to paragraph 0)
           (for-each (lambda (character) (key-press (string character)))
                     (string->list marker))
           (commit-changes)
           (check (contains? (buffer-tree) marker) "keyboard text disappeared"))
         (let ((formula (append-paragraph '(math ""))))
           (tree-go-to (tree-ref formula 0) 0)
           (key-press "(")
           (key-press "x")
           (key-press "^")
           (key-press "2")
           (commit-changes)
           (check (has-tag? formula 'delimited) "keyboard did not create native delimiters")
           (check (has-tag? formula 'scripts) "keyboard did not create native superscript"))
         (check (not (buffer-save source)) "normal v3 save failed")
         (append-paragraph auto-marker)
         (check (not (buffer-export source autosave "texmacs")) "v3 autosave failed"))
        ((equal? phase "reopen")
         (check (contains? (buffer-tree) marker) "fresh process lost saved text")
         (check (not (contains? (buffer-tree) auto-marker)) "normal save included later autosave edit")
         (check (not (buffer-save source)) "fresh process resave failed"))
        ((equal? phase "recover")
         (check (contains? (buffer-tree) marker) "recovery lost saved text")
         (check (contains? (buffer-tree) auto-marker) "recovery lost autosave text")
         (check (not (buffer-save recovered)) "recovered v3 save failed"))
        (else (error "Unknown v3 persistence phase" phase)))
      (exec-global (lambda () (finish #t))))
    fail))

(catch #t
  (lambda ()
    (set-preference "document save mode" "manual")
    (when (equal? phase "candidate")
      (let ((answer (vault-load-with-ns (string->url root) "Unpublished fixture"
                                       "map.sqlite" "ns.sqlite")))
        (check (string-contains? answer "Unpublished XML v3 migration candidates cannot be opened")
               "unpublished candidate entered normal runtime")
        (finish #t)))
    (when (equal? phase "audit")
      (let ((failures '()) (completed 0))
        (for-each
          (lambda (filename)
            (let ((name (string->url filename)))
              (catch #t
                (lambda ()
                  (check (not (buffer-load name)) filename)
                  (check (not (buffer-save name)) filename))
                (lambda args (set! failures (cons (cons filename args) failures))))
              (cpp-buffer-close name)
              (set! completed (+ completed 1))
              (when (= (modulo completed 32) 0)
                (display "V3 corpus documents completed: ")
                (display completed) (newline) (force-output))))
          (call-with-input-file (string-append root "/files.scm") read))
        (if (null? failures) (finish #t) (finish failures))))
    (when (equal? (getenv "ATHENA_V3_PERSISTENCE_VAULT") "yes")
      (check (equal? (vault-load-with-ns (string->url root) "Isolated v3 persistence"
                                       "map.sqlite" "ns.sqlite") "")
             "could not activate local v3 Vault")
      (when (equal? phase "edit")
        (let ((created (string->url (string-append root "/created.ath"))))
          (check (not (buffer-create-source created)) "new v3 Vault document creation failed")
          (check (not (buffer-save created)) "new v3 Vault document save failed"))))
    (let ((target (if (equal? phase "recover") recovered source)))
      (check (not (if (equal? phase "recover")
                      (buffer-import recovered autosave "texmacs")
                      (buffer-load source))) "normal buffer load failed")
      (switch-to-buffer target)
      (check (exec-buffer target run-owned) "could not enter owning actor")))
  (lambda args (finish args)))
