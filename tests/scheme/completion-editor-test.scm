;; Real BufferActor completion: opening/navigating must not mutate the buffer.
;; custom-complete belonged to the retired external-session completion API;
;; exercise the surviving document-word completion path directly instead.
(init-style "generic")
(define initial-mode (get-input-mode))
(define (body) (tree->stree (buffer-tree)))
(define (reset words)
  (buffer-set-body (current-buffer) (stree->tree (cons 'document words)))
  (update-current-buffer)
  (update-forced)
  (tree-go-to (tree-ref (buffer-tree) (- (tree-arity (buffer-tree)) 1)) :end))
(define (start)
  (unless (complete-try?) (error "Document words did not produce candidates")))

(set-boolean-preference "realtime text autocompletion" #t)
(reset '("alpha" "alpine" "a"))
(keyboard-press "l" 0)
(unless (equal? (body) '(document "alpha" "alpine" "al"))
  (error "Realtime completion changed typed text"))
(when (= (get-input-mode) initial-mode)
  (error "Realtime completion did not open while typing"))
(keyboard-press "p" 0)
(unless (equal? (body) '(document "alpha" "alpine" "alp"))
  (error "Realtime completion refresh changed typed text"))
(when (= (get-input-mode) initial-mode)
  (error "Realtime completion did not refresh while typing"))
(key-press-complete "escape")

;; Macro entry has its own command candidates, not document-word completion.
(buffer-set-body (current-buffer)
                 (stree->tree
                   '(document "alpha" "alpine" (inactive (hybrid "a")))))
(update-current-buffer)
(update-forced)
(tree-go-to (tree-ref (buffer-tree) 2 0 0) :end)
(keyboard-press "l" 0)
(unless (equal? (body)
                '(document "alpha" "alpine" (inactive (hybrid "al"))))
  (error "Typing in backslash macro input changed the document unexpectedly"))
(when (= (get-input-mode) initial-mode)
  (error "Macro name completion did not open"))
(key-press-complete "escape")

(set-boolean-preference "realtime text autocompletion" #f)
(reset '("alpha" "alpine" "a"))
(keyboard-press "l" 0)
(unless (equal? (body) '(document "alpha" "alpine" "al"))
  (error "Disabled realtime completion changed typed text"))
(unless (= (get-input-mode) initial-mode)
  (error "Realtime completion opened while disabled"))

;; Candidate order can stay alphabetical or favor words used more often in
;; the current buffer. Equal-frequency candidates remain alphabetical.
(set-preference "text autocompletion sorting" "alphabetical")
(reset '("alpine" "alpha" "al"))
(start)
(key-press-complete "return")
(unless (equal? (body) '(document "alpine" "alpha" "alpha"))
  (error "Alphabetical completion order selected the wrong candidate"))

(set-preference "text autocompletion sorting" "frequency")
(reset '("alpha" "alpine" "alpine" "alpine" "al"))
(start)
(key-press-complete "return")
(unless (equal? (body)
                '(document "alpha" "alpine" "alpine" "alpine" "alpine"))
  (error "Frequency completion order selected the wrong candidate"))

;; Acceptance can be restricted to Enter or Tab. A disabled acceptance key
;; returns false after closing completion so normal keyboard handling may run.
(set-preference "text autocompletion accept key" "enter")
(reset '("alpha" "al"))
(start)
(when (key-press-complete "tab")
  (error "Tab accepted completion in Enter-only mode"))
(unless (equal? (body) '(document "alpha" "al"))
  (error "Rejected Tab changed the completion text"))
(start)
(unless (key-press-complete "return")
  (error "Enter did not accept completion in Enter-only mode"))
(unless (equal? (body) '(document "alpha" "alpha"))
  (error "Enter-only completion accepted the wrong text"))

(set-preference "text autocompletion accept key" "tab")
(reset '("alpha" "al"))
(start)
(when (key-press-complete "return")
  (error "Enter accepted completion in Tab-only mode"))
(unless (equal? (body) '(document "alpha" "al"))
  (error "Rejected Enter changed the completion text"))
(start)
(unless (key-press-complete "tab")
  (error "Tab did not accept completion in Tab-only mode"))
(unless (equal? (body) '(document "alpha" "alpha"))
  (error "Tab-only completion accepted the wrong text"))

(set-preference "text autocompletion sorting" "alphabetical")
(set-preference "text autocompletion accept key" "both")

(reset '("alpha" "alpine" "al"))
(start)
(unless (equal? (body) '(document "alpha" "alpine" "al"))
  (error "Opening completion inserted text"))
(when (= (get-input-mode) initial-mode) (error "Completion did not open"))
(key-press-complete "down")
(unless (equal? (body) '(document "alpha" "alpine" "al"))
  (error "Navigation inserted text"))
(key-press-complete "tab")
(unless (equal? (body) '(document "alpha" "alpine" "alpine"))
  (error "TAB accepted wrong choice"))
(unless (= (get-input-mode) initial-mode)
  (error "Acceptance left completion active"))

(reset '("alpha" "alpine" "al"))
(start)
(key-press-complete "escape")
(unless (equal? (body) '(document "alpha" "alpine" "al"))
  (error "Cancel changed document"))

(start)
(tree-go-to (tree-ref (buffer-tree) 0) :start)
(key-press-complete "return")
(unless (equal? (body) '(document "alpha" "alpine" "al"))
  (error "Stale cursor accepted completion"))

(reset '("alpha" "al"))
(start)
(unless (equal? (body) '(document "alpha" "al"))
  (error "Single choice inserted eagerly"))
(key-press-complete "return")
(unless (equal? (body) '(document "alpha" "alpha"))
  (error "Enter failed"))

;; Structured arguments, explicit body placement, cancellation, and activation.
(init-env-tree "test-input-macro"
               '(macro "title" "body" (concat (arg "title") (arg "body"))))
(reset '("selected"))
(selection-set (tree->path (tree-ref (buffer-tree) 0) :start)
               (tree->path (tree-ref (buffer-tree) 0) :end))
(make-hybrid)
(insert "test-input-macro")
(unless (hybrid-name-context?) (error "Generated hybrid context binding missing"))
(keyboard-press "tab" 0)
(unless (equal? (body)
                '(document (inactive (hybrid "test-input-macro"
                                      (tuple "" "selected") ""))))
  (error "Selection was not placed in the declared body argument" (body)))
(insert "Title")
(keyboard-press "return" 0)
(unless (equal? (body) '(document (test-input-macro "Title" "selected")))
  (error "Macro arguments were not committed" (body)))
(commit-changes)
(unless (> (undo-possibilities) 0) (error "Macro input has no undo history"))
(undo 0)
(unless (equal? (body) '(document "selected"))
  (error "Macro insertion was not one undo step" (body)))

(reset '("restore"))
(selection-set (tree->path (tree-ref (buffer-tree) 0) :start)
               (tree->path (tree-ref (buffer-tree) 0) :end))
(make-hybrid)
(insert "test-input-macro")
(keyboard-press "tab" 0)
(keyboard-press "escape" 0)
(unless (and (equal? (body) '(document "restore")) (selection-active-any?))
  (error "Cancel did not restore the selected source" (body)))
(selection-cancel)

(reset '(""))
(make-hybrid)
(insert "test-input-macr")
(start)
(key-press-complete "tab")
(unless (equal? (body)
                '(document (inactive (hybrid "test-input-macro" (tuple "" "") ""))))
  (error "Macro completion did not prepare argument slots" (body)))
(insert '(math (frac "a" "b")))
(keyboard-press "tab" 0)
(insert "Body")
(keyboard-press "return" 0)
(unless (equal? (body)
                '(document (test-input-macro (math (frac "a" "b")) "Body")))
  (error "Structured arguments lost their tree representation" (body)))

;; Without a declared body, keep the selection until an argument is chosen.
(init-env-tree "test-input-pair"
               '(macro "left" "right" (concat (arg "left") (arg "right"))))
(reset '("kept"))
(selection-set (tree->path (tree-ref (buffer-tree) 0) :start)
               (tree->path (tree-ref (buffer-tree) 0) :end))
(make-hybrid)
(insert "test-input-pair")
(keyboard-press "tab" 0)
(unless (equal? (body)
                '(document (inactive (hybrid "test-input-pair" (tuple "" "") "kept"))))
  (error "Ambiguous selection was assigned without a choice" (body)))
(keyboard-press "tab" 0)
(keyboard-press "return" 0)
(keyboard-press "return" 0)
(unless (equal? (body) '(document (test-input-pair "" "kept")))
  (error "Explicit selection placement failed" (body)))

(init-env "page-medium" "paper")
(update-current-buffer)
(update-forced)
(print-to-file (string->url (string-append (getenv "HOME") "/evaluation.pdf")))
