;; Focused contract test: evaluate the production inserter result consumers.
(use-modules (srfi srfi-1) (srfi srfi-13))
(define root (cadr (command-line)))
(define (check ok message) (unless ok (error message)))
(define == equal?)
(define (tree? value) (or (pair? value) (string? value)))
(define tree-label car)
(define (tree-arity value) (length (cdr value)))
(define (tree-ref value index) (list-ref (cdr value) index))
(define (tree->string value) (check (string? value) "Expected text") value)
(define (tree->stree value) value)
(define migrated? #t)
(define (vault-get-node-model-version) (if migrated? 1 0))
(define (vault-url-component-encode value) value) ; fixtures contain UUIDs only
(define inserted #f)
(define mapped 0)
(define (insert value) (set! inserted value))
(define (set-message . args) #f)
(define (vault-find-uuid . args) "")
(define (vault-generate-uuid) "legacy-id")
(define (vault-set-node . args) (set! mapped (+ mapped 1)))

(call-with-input-file
  (string-append root "/ATHENA/progs/athena/athena/tm-vault.scm")
  (lambda (port)
    (let loop ((form (read port)))
      (unless (eof-object? form)
        (when (and (pair? form) (eq? (car form) 'define)
                   (pair? (cadr form))
                   (memq (caadr form)
                     '(vault-wikilink-url vault-node-model-active?
                       insert-wikilink-complete insert-transclude-complete)))
          (eval form (current-module)))
        (loop (read port))))))

(define id "11111111-1111-4111-8111-111111111111")
(define second "22222222-2222-4222-8222-222222222222")
(insert-wikilink-complete `(tuple "Old path.ath" "" "Visible" ,id))
(check (equal? inserted `(hlink "Visible" ,(string-append "tmfs://wikilink/" id)))
       "Native wikilink must contain only its source UUID")
(insert-transclude-complete `(tuple "Old path.ath" "" "" (tuple ,id ,second)))
(check (equal? inserted `(transclude (tuple ,id ,second)))
       "Native transclusion must preserve its ordered UUID list")
(check (= mapped 0) "Native insertion must not write the legacy map")

(set! inserted #f)
(insert-wikilink-complete `(tuple "" "" "file hint" "anchor hint" "Visible" ,id))
(check (not inserted) "Do not misinterpret an old six-field result")
(set! migrated? #f)
(insert-wikilink-complete '(tuple "Legacy.ath" "Target" "Visible" ""))
(check (equal? inserted '(hlink "Visible" "tmfs://wikilink/legacy-id"))
       "Legacy insertion must not append hints either")
(insert-transclude-complete '(tuple "Legacy.ath" "Begin" "End" (tuple)))
(check (equal? inserted '(transclude "legacy-id" "" "Begin" "End"))
       "Keep the legacy node shape without collecting a recovery hint")
(check (= mapped 2) "Legacy targets still use their existing map contract")
(display "PASS: hint-free native and legacy inserter results\n")
